+import 'dart:io';
+
+import 'package:c001apk_flutter/pages/search/search_page.dart';
+import 'package:c001apk_flutter/utils/storage_util.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:hive/hive.dart';
+
+void main() {
+  late Directory directory;
+  setUpAll(() async {
+    directory = await Directory.systemTemp.createTemp('search-drag-keyboard-');
+    Hive.init(directory.path);
+    GStorage.searchHistory = await Hive.openBox('searchHistory');
+  });
+  tearDown(Get.reset);
+  tearDownAll(() async {
+    await Hive.close();
+    await directory.delete(recursive: true);
+  });
+
+  for (final platform in [TargetPlatform.iOS, TargetPlatform.android]) {
+    testWidgets('history drag preserves input and follows $platform keyboard policy',
+        (tester) async {
+      final history = List.generate(60, (index) => 'saved search number $index');
+      await tester.runAsync(
+          () => GStorage.searchHistory.put('searchHistory', history));
+      await tester.binding.setSurfaceSize(const Size(400, 850));
+      tester.view.viewInsets = const FakeViewPadding(bottom: 280);
+      addTearDown(() {
+        tester.view.resetViewInsets();
+        return tester.binding.setSurfaceSize(null);
+      });
+      await tester.pumpWidget(GetMaterialApp(
+        theme: ThemeData(platform: platform),
+        home: const SearchPage(),
+      ));
+      await tester.pumpAndSettle();
+      await tester.enterText(find.byType(TextField), 'unfinished query');
+      await tester.pumpAndSettle();
+      final editor = tester.widget<TextField>(find.byType(TextField));
+      expect(editor.focusNode!.hasFocus, isTrue);
+      expect(tester.takeException(), isNull,
+          reason: 'The history viewport must fit above the keyboard.');
+      await tester.drag(find.byType(SingleChildScrollView), const Offset(0, -140));
+      await tester.pumpAndSettle();
+      expect(editor.focusNode!.hasFocus, platform != TargetPlatform.iOS);
+      expect(editor.controller!.text, 'unfinished query');
+      expect(GStorage.searchHistory.get('searchHistory'), history,
+          reason: 'Dismissing the keyboard must not submit or clear a search.');
+      expect(find.byType(SearchPage), findsOneWidget);
+      expect(tester.takeException(), isNull);
+      await tester.pumpWidget(const SizedBox.shrink());
+    });
+  }
+}
diff --git a/apps/flutter/tool/ios_gesture_smoke.dart b/apps/flutter/tool/ios_gesture_smoke.dart
new file mode 100644
index 0000000..dcc03da
--- /dev/null
+++ b/apps/flutter/tool/ios_gesture_smoke.dart
@@ -0,0 +1,302 @@
+// Simulator-only fixture. Production IPA builds must target lib/main.dart.
+// No account, storage initialization or network request is performed here.
+import 'dart:async';
+import 'dart:math' as math;
+import 'dart:ui' as ui;
+
+import 'package:flutter/material.dart';
+import 'package:get/get.dart';
+import 'package:photo_view/photo_view.dart';
+import 'package:photo_view/photo_view_gallery.dart';
+
+import 'package:c001apk_flutter/components/html_text.dart';
+import '../lib/components/liquid_navigation_bar.dart';
+import '../lib/pages/others/imageview_page.dart';
+import '../lib/router/app_pages.dart';
+
+GetPage _fixtureRoute(String name, Widget Function() page) {
+  final production =
+      AppPages.getPages.singleWhere((route) => route.name == name);
+  return GetPage(
+    name: production.name,
+    page: page,
+    transition: production.transition,
+    transitionDuration: production.transitionDuration,
+    customTransition: production.customTransition,
+    popGesture: production.popGesture,
+  );
+}
+
+Future<List<MemoryImage>> _offlineImages() async {
+  final images = <MemoryImage>[];
+  for (final color in [Colors.teal, Colors.indigo, Colors.deepOrange]) {
+    final recorder = ui.PictureRecorder();
+    final canvas = Canvas(recorder);
+    canvas.drawRect(
+        const Rect.fromLTWH(0, 0, 800, 600), Paint()..color = color);
+    for (var row = 0; row < 6; row++) {
+      for (var column = 0; column < 8; column++) {
+        if ((row + column).isEven) {
+          canvas.drawRect(Rect.fromLTWH(column * 100.0, row * 100.0, 100, 100),
+              Paint()..color = Colors.white.withValues(alpha: 0.25));
+        }
+      }
+    }
+    canvas.drawCircle(
+        const Offset(400, 300), 75, Paint()..color = Colors.amber);
+    canvas.drawCircle(
+        const Offset(400, 300), 25, Paint()..color = Colors.black);
+    final picture = recorder.endRecording();
+    final decoded = await picture.toImage(800, 600);
+    try {
+      final data = await decoded.toByteData(format: ui.ImageByteFormat.png);
+      if (data == null) throw StateError('Could not create the offline image');
+      images.add(MemoryImage(data.buffer.asUint8List()));
+    } finally {
+      decoded.dispose();
+      picture.dispose();
+    }
+  }
+  return images;
+}
+
+Future<void> main() async {
+  WidgetsFlutterBinding.ensureInitialized().ensureSemantics();
+  final images = await _offlineImages();
+  runApp(GetMaterialApp(
+    debugShowCheckedModeBanner: false,
+    theme: ThemeData(
+      platform: TargetPlatform.iOS,
+      colorScheme: ColorScheme.fromSeed(
+          seedColor: Colors.deepPurple, brightness: Brightness.dark),
+    ),
+    initialRoute: '/',
+    getPages: [
+      _fixtureRoute('/', () => _FixtureHome(images: images)),
+      _fixtureRoute('/feed/:id', () => const _FixturePost()),
+      _fixtureRoute('/imageview', () => _FixtureImagePage(images: images)),
+    ],
+  ));
+}
+
+class _FixtureHome extends StatefulWidget {
+  const _FixtureHome({required this.images});
+  final List<MemoryImage> images;
+
+  @override
+  State<_FixtureHome> createState() => _FixtureHomeState();
+}
+
+class _FixtureHomeState extends State<_FixtureHome> {
+  int _selected = 2;
+  bool _openingImages = false;
+
+  Future<void> _openImages() async {
+    if (_openingImages) return;
+    _openingImages = true;
+    try {
+      // The image page uses its real loading/scale path, but all providers are
+      // already decoded before XCTest begins a gesture. Failed precaching
+      // prevents navigation instead of producing a false-positive empty page.
+      for (final image in widget.images) {
+        Object? failure;
+        StackTrace? failureStack;
+        await precacheImage(image, context, onError: (error, stack) {
+          failure = error;
+          failureStack = stack;
+        });
+        if (failure != null) {
+          Error.throwWithStackTrace(
+              failure!, failureStack ?? StackTrace.current);
+        }
+        if (!mounted) return;
+      }
+      Get.toNamed('/imageview', arguments: {
+        'imgList': [
+          'memory://one.png',
+          'memory://two.png',
+          'memory://three.png'
+        ],
+        'initialPage': 1,
+      });
+    } finally {
+      _openingImages = false;
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        appBar: AppBar(title: const Text('iOS gesture fixture')),
+        body: Center(
+          child: Column(mainAxisSize: MainAxisSize.min, children: [
+            const Text('Offline fixture - no account data'),
+            const SizedBox(height: 24),
+            FilledButton(
+              onPressed: () => Get.toNamed('/feed/smoke'),
+              child: const Text('Open post'),
+            ),
+            const SizedBox(height: 16),
+            FilledButton(
+              onPressed: _openImages,
+              child: const Text('Open images'),
+            ),
+          ]),
+        ),
+        bottomNavigationBar: LiquidNavigationBar(
+          selectedIndex: _selected,
+          onDestinationSelected: (value) => setState(() => _selected = value),
+        ),
+      );
+}
+
+/// The probe only reads the production widgets/controllers. It never sets a
+/// page or scale, so XCTest must make the actual native gestures succeed.
+class _FixtureImagePage extends StatefulWidget {
+  const _FixtureImagePage({required this.images});
+  final List<MemoryImage> images;
+
+  @override
+  State<_FixtureImagePage> createState() => _FixtureImagePageState();
+}
+
+class _FixtureImagePageState extends State<_FixtureImagePage> {
+  final _pageKey = GlobalKey();
+  late final Widget _page;
+  late final Timer _probe;
+  String _imageState = 'Waiting for the real image';
+
+  @override
+  void initState() {
+    super.initState();
+    final providers = Map<String, MemoryImage>.fromIterables(
+        ['memory://one.png', 'memory://two.png', 'memory://three.png'],
+        widget.images);
+    _page = ImageViewPage(imageProviderBuilder: (url) => providers[url]!);
+    _probe = Timer.periodic(const Duration(milliseconds: 100), (_) => _read());
+  }
+
+  void _read() {
+    if (!mounted || ModalRoute.of(context)?.isCurrent != true) return;
+    final root = _pageKey.currentContext;
+    if (root == null) return;
+    PhotoViewGallery? gallery;
+    Size? viewport;
+    final photos = <int, PhotoView>{};
+    void visit(Element element) {
+      final widget = element.widget;
+      if (widget is PhotoViewGallery) {
+        gallery = widget;
+        final box = element.findRenderObject();
+        if (box is RenderBox && box.hasSize) viewport = box.size;
+      } else if (widget is PhotoView) {
+        for (var index = 0; index < 3; index++) {
+          if (widget.key == ObjectKey(index)) photos[index] = widget;
+        }
+      }
+      element.visitChildElements(visit);
+    }
+
+    root.visitChildElements(visit);
+    final pages = gallery?.pageController;
+    if (pages == null || pages.positions.length != 1 || viewport == null)
+      return;
+    final current = pages.page;
+    if (current == null) return;
+    final index = current.round();
+    final scale = photos[index]?.controller?.scale;
+    if (scale == null || !scale.isFinite || scale <= 0) return;
+    final contained = math.min(viewport!.width / 800, viewport!.height / 600);
+    final zoom = (scale - contained).abs() <= contained * 0.01
+        ? 'contained'
+        : scale > contained * 1.01
+            ? 'zoomed'
+            : 'transitioning';
+    final stationary = !pages.position.isScrollingNotifier.value &&
+        (current - index).abs() <= 0.001;
+    final state =
+        stationary ? 'Image ${index + 1} of 3 - $zoom' : 'Image gallery moving';
+    if (_imageState != state) setState(() => _imageState = state);
+  }
+
+  @override
+  void dispose() {
+    _probe.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Stack(children: [
+        KeyedSubtree(key: _pageKey, child: _page),
+        Positioned(
+          left: 12,
+          right: 12,
+          bottom: MediaQuery.paddingOf(context).bottom + 8,
+          child: IgnorePointer(
+            child: Semantics(
+              identifier: 'smoke-image-state',
+              container: true,
+              label: _imageState,
+              child: ExcludeSemantics(
+                child: ColoredBox(
+                  color: Colors.black,
+                  child: Text(_imageState,
+                      textAlign: TextAlign.center,
+                      style:
+                          const TextStyle(color: Colors.white, fontSize: 12)),
+                ),
+              ),
+            ),
+          ),
+        ),
+      ]);
+}
+
+class _FixturePost extends StatefulWidget {
+  const _FixturePost();
+
+  @override
+  State<_FixturePost> createState() => _FixturePostState();
+}
+
+class _FixturePostState extends State<_FixturePost> {
+  final _gallery = PageController(initialPage: 1);
+
+  @override
+  void dispose() {
+    _gallery.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        appBar: AppBar(title: const Text('Smoke post')),
+        body: ListView(children: [
+          // Exercise the production plain-comment renderer under native drags.
+          // These unformatted fixture strings need neither storage nor network.
+          SizedBox(
+              height: 120, child: Center(child: htmlText('Body drag region'))),
+          Semantics(
+            identifier: 'smoke-gallery',
+            container: true,
+            child: SizedBox(
+              height: 180,
+              child: PageView(
+                controller: _gallery,
+                children: [
+                  for (var i = 0; i < 3; i++)
+                    ColoredBox(
+                      color: [Colors.teal, Colors.indigo, Colors.deepOrange][i],
+                      child: Center(child: Text('Gallery page ${i + 1}')),
+                    ),
+                ],
+              ),
+            ),
+          ),
+          for (var i = 0; i < 25; i++)
+            SizedBox(
+              height: 90,
+              child: Center(child: htmlText('Body row $i')),
+            ),
+        ]),
+      );
+}
diff --git a/apps/flutter/tool/ios_gesture_ui_tests.swift b/apps/flutter/tool/ios_gesture_ui_tests.swift
new file mode 100644
index 0000000..251da6c
--- /dev/null
+++ b/apps/flutter/tool/ios_gesture_ui_tests.swift
@@ -0,0 +1,141 @@
+import XCTest
+
+/// Runs only against tool/ios_gesture_smoke.dart, never the user's account UI.
+final class GestureSmokeUITests: XCTestCase {
+    private let app = XCUIApplication()
+
+    override func setUpWithError() throws {
+        continueAfterFailure = false
+        app.launch()
+        XCTAssertTrue(app.buttons["Open post"].waitForExistence(timeout: 30))
+    }
+
+    private func openPost() {
+        app.buttons["Open post"].tap()
+        XCTAssertTrue(app.staticTexts["Smoke post"].waitForExistence(timeout: 10))
+        XCTAssertTrue(app.staticTexts["Body drag region"].waitForExistence(timeout: 10))
+        // Flutter owns this transition; wait beyond its 450 ms route animation
+        // before injecting the next touch into the independently running app.
+        Thread.sleep(forTimeInterval: 0.8)
+    }
+
+    private func waitForImage(_ number: Int, zoom: String = "contained",
+                              file: StaticString = #filePath, line: UInt = #line) {
+        let status = app.descendants(matching: .any)
+            .matching(identifier: "smoke-image-state").firstMatch
+        let expected = "Image \(number) of 3 - \(zoom)"
+        let predicate = NSPredicate(format: "exists == true AND label == %@", expected)
+        let result = XCTWaiter.wait(
+            for: [XCTNSPredicateExpectation(predicate: predicate, object: status)], timeout: 10)
+        XCTAssertEqual(result, .completed, "Expected real PhotoView state: \(expected)",
+                       file: file, line: line)
+        XCTAssertTrue(app.staticTexts["\(number)/3"].exists, file: file, line: line)
+        XCTAssertFalse(app.buttons["Open images"].exists, file: file, line: line)
+    }
+
+    private func openImages() {
+        XCTAssertTrue(app.buttons["Open images"].waitForExistence(timeout: 10))
+        app.buttons["Open images"].tap()
+        waitForImage(2)
+        Thread.sleep(forTimeInterval: 0.8)
+    }
+
+    private func assertReturnedFromImages(file: StaticString = #filePath, line: UInt = #line) {
+        XCTAssertTrue(app.buttons["Open images"].waitForExistence(timeout: 10),
+                      file: file, line: line)
+        XCTAssertFalse(app.staticTexts["2/3"].exists, file: file, line: line)
+        XCTAssertFalse(app.descendants(matching: .any)
+            .matching(identifier: "smoke-image-state").firstMatch.exists, file: file, line: line)
+    }
+
+    private func point(_ x: CGFloat, _ y: CGFloat) -> XCUICoordinate {
+        app.coordinate(withNormalizedOffset: CGVector(dx: 0, dy: 0))
+            .withOffset(CGVector(dx: app.frame.width * x, dy: y - app.frame.minY))
+    }
+
+    private func record(_ name: String) {
+        let attachment = XCTAttachment(screenshot: app.screenshot())
+        attachment.name = name
+        attachment.lifetime = .keepAlways
+        add(attachment)
+    }
+
+    func testBodyRightSwipeReturnsToList() {
+        record("ios27_navigation_fixture")
+        openPost()
+        record("ios27_post_before_swipe")
+        let y = app.staticTexts["Body drag region"].frame.midY
+        point(0.25, y).press(forDuration: 0.05, thenDragTo: point(0.94, y))
+        XCTAssertTrue(app.buttons["Open post"].waitForExistence(timeout: 10))
+        XCTAssertFalse(app.staticTexts["Smoke post"].exists)
+        record("ios27_returned_to_list")
+    }
+
+    func testVerticalScrollDoesNotReturn() {
+        openPost()
+        let startY = app.frame.minY + app.frame.height * 0.80
+        let endY = app.frame.minY + app.frame.height * 0.35
+        point(0.55, startY).press(forDuration: 0.05, thenDragTo: point(0.55, endY))
+        XCTAssertTrue(app.staticTexts["Smoke post"].exists)
+        XCTAssertFalse(app.buttons["Open post"].exists)
+        XCTAssertFalse(app.staticTexts["Body drag region"].isHittable)
+        record("ios27_vertical_scroll_stays_in_post")
+    }
+
+    func testGalleryOwnsItsHorizontalDrag() {
+        openPost()
+        XCTAssertTrue(app.staticTexts["Gallery page 2"].waitForExistence(timeout: 10))
+        let y = app.staticTexts["Gallery page 2"].frame.midY
+        point(0.25, y).press(forDuration: 0.05, thenDragTo: point(0.94, y))
+        XCTAssertTrue(app.staticTexts["Gallery page 1"].waitForExistence(timeout: 10))
+        XCTAssertTrue(app.staticTexts["Smoke post"].exists)
+        XCTAssertFalse(app.buttons["Open post"].exists)
+        record("ios27_gallery_swipe_stays_in_post")
+    }
+
+    func testRealImageDownwardDragReturnsToList() {
+        openImages()
+        record("ios27_real_image_before_downward_drag")
+        let startY = app.frame.minY + app.frame.height * 0.40
+        let endY = app.frame.minY + app.frame.height * 0.80
+        point(0.50, startY).press(forDuration: 0.05, thenDragTo: point(0.50, endY))
+        assertReturnedFromImages()
+        record("ios27_real_image_downward_drag_returned")
+    }
+
+    func testRealImageHorizontalSwipesChangePagesWithoutReturning() {
+        openImages()
+        let y = app.frame.minY + app.frame.height * 0.53
+        point(0.80, y).press(forDuration: 0.05, thenDragTo: point(0.15, y))
+        waitForImage(3)
+        record("ios27_real_image_swiped_to_third")
+        point(0.20, y).press(forDuration: 0.05, thenDragTo: point(0.85, y))
+        waitForImage(2)
+        record("ios27_real_image_swiped_back_to_second")
+    }
+
+    func testRealImagePinchAndDownwardPanDoNotReturn() {
+        openImages()
+        app.pinch(withScale: 2.5, velocity: 1.5)
+        // Check the real controller's scale before panning. Merely remaining
+        // on the page would also pass when an injected pinch did nothing.
+        waitForImage(2, zoom: "zoomed")
+        record("ios27_real_image_pinch_zoomed")
+        let startY = app.frame.minY + app.frame.height * 0.40
+        let endY = app.frame.minY + app.frame.height * 0.80
+        point(0.50, startY).press(forDuration: 0.05, thenDragTo: point(0.50, endY))
+        // Let any incorrectly started route-pop animation finish before the
+        // negative assertion; a departing page can briefly retain semantics.
+        Thread.sleep(forTimeInterval: 0.8)
+        waitForImage(2, zoom: "zoomed")
+        record("ios27_real_image_zoomed_pan_stayed_open")
+    }
+
+    func testRealImageLeadingEdgeReturnsToList() {
+        openImages()
+        let y = app.frame.minY + app.frame.height * 0.53
+        point(0.01, y).press(forDuration: 0.05, thenDragTo: point(0.90, y))
+        assertReturnedFromImages()
+        record("ios27_real_image_leading_edge_returned")
+    }
+}
diff --git a/apps/flutter/tool/setup_ios_gesture_ui_tests.rb b/apps/flutter/tool/setup_ios_gesture_ui_tests.rb
new file mode 100644
index 0000000..e2bf8ec
--- /dev/null
+++ b/apps/flutter/tool/setup_ios_gesture_ui_tests.rb
@@ -0,0 +1,89 @@
+#!/usr/bin/env ruby
+# Adds a temporary XCTest UI target without changing CocoaPods dependencies.
+# Run from apps/flutter, after the simulator fixture has been built by Flutter.
+require 'fileutils'
+require 'xcodeproj'
+
+root = File.expand_path('..', __dir__)
+project_path = File.join(root, 'ios/Runner.xcodeproj')
+project_file = File.join(project_path, 'project.pbxproj')
+backup = File.join(root, 'build/ios-smoke-backup/project.pbxproj')
+scheme_file = File.join(project_path, 'xcshareddata/xcschemes/GestureSmoke.xcscheme')
+runner_scheme_file = File.join(project_path, 'xcshareddata/xcschemes/Runner.xcscheme')
+test_folder = File.join(root, 'ios/GestureSmokeUITests')
+
+if ARGV == ['--clean']
+  abort 'No smoke-test project backup to restore' unless File.file?(backup)
+  FileUtils.cp(backup, project_file)
+  FileUtils.rm_f(scheme_file)
+  FileUtils.rm_f(File.join(test_folder, 'ios_gesture_ui_tests.swift'))
+  Dir.rmdir(test_folder) if Dir.exist?(test_folder) && Dir.empty?(test_folder)
+  puts 'Restored Runner project; production build may target lib/main.dart.'
+  exit
+end
+abort 'Usage: ruby tool/setup_ios_gesture_ui_tests.rb [--clean]' unless ARGV.empty?
+
+project = Xcodeproj::Project.open(project_path)
+abort 'GestureSmokeUITests already exists; clean first' if project.targets.any? { |t| t.name == 'GestureSmokeUITests' }
+runner = project.targets.find { |target| target.name == 'Runner' }
+abort 'Runner target not found' unless runner
+abort 'Runner scheme not found; build the Flutter simulator fixture first' unless File.file?(runner_scheme_file)
+FileUtils.mkdir_p(File.dirname(backup))
+FileUtils.cp(project_file, backup)
+FileUtils.mkdir_p(test_folder)
+FileUtils.cp(File.join(__dir__, 'ios_gesture_ui_tests.swift'), test_folder)
+
+tests = project.new_target(:ui_test_bundle, 'GestureSmokeUITests', :ios, '15.0')
+tests.add_dependency(runner)
+group = project.main_group.new_group('GestureSmokeUITests', 'GestureSmokeUITests')
+reference = group.new_file('ios_gesture_ui_tests.swift')
+tests.source_build_phase.add_file_reference(reference)
+tests.build_configurations.each do |configuration|
+  configuration.build_settings.merge!(
+    'PRODUCT_NAME' => 'GestureSmokeUITests',
+    'PRODUCT_MODULE_NAME' => 'GestureSmokeUITests',
+    'PRODUCT_BUNDLE_IDENTIFIER' => 'com.randyliu2020.c001apk.lite.GestureSmokeUITests',
+    'GENERATE_INFOPLIST_FILE' => 'YES',
+    'SWIFT_VERSION' => '5.0',
+    'TEST_TARGET_NAME' => 'Runner',
+    'TARGETED_DEVICE_FAMILY' => '1,2',
+    'CODE_SIGNING_ALLOWED' => 'NO',
+    'IPHONEOS_DEPLOYMENT_TARGET' => '15.0'
+  )
+end
+project.save
+
+# Flutter's first simulator build migrates Runner.xcscheme for SwiftPM. Starting
+# with an empty scheme drops its framework-prepare pre-action: packages then
+# compile before Flutter.framework exists in this invocation's build directory.
+# Clone the migrated scheme, including all pre/post actions and Runner's launch
+# environment, and change only which test bundle is built and executed.
+scheme = Xcodeproj::XCScheme.new(runner_scheme_file)
+scheme.add_build_target(tests, false)
+scheme.test_action.testables = []
+scheme.add_test_target(tests)
+
+# Older checkouts may still have the pre-SwiftPM Runner scheme. Follow Flutter's
+# documented integration in that case. Run this as a scheme build pre-action,
+# with Runner's settings, so it uses the same configuration/SDK/DerivedData as
+# the subsequent Swift package compilation (not a previous Flutter build).
+prepare_actions = (scheme.build_action.pre_actions || []).select do |action|
+  action.action_type == Xcodeproj::Constants::EXECUTION_ACTION_TYPE[:shell_script] &&
+    action.action_content.script_text.to_s.match?(/xcode_backend\.sh["']?\s+prepare\b/)
+end
+if prepare_actions.empty?
+  prepare = Xcodeproj::XCScheme::ExecutionAction.new(nil, :shell_script)
+  content = Xcodeproj::XCScheme::ShellScriptActionContent.new
+  content.title = 'Run Prepare Flutter Framework Script'
+  content.script_text = '/bin/sh "$FLUTTER_ROOT/packages/flutter_tools/bin/xcode_backend.sh" prepare' + "\n"
+  prepare.action_content = content
+  scheme.build_action.add_pre_action(prepare)
+  prepare_actions = [prepare]
+end
+prepare_actions.each do |action|
+  action.action_content.buildable_reference = Xcodeproj::XCScheme::BuildableReference.new(runner)
+end
+scheme.test_action.build_configuration = 'Debug'
+scheme.launch_action.build_configuration = 'Debug'
+scheme.save_as(project_path, 'GestureSmoke', true)
+puts 'Created temporary GestureSmoke scheme with Flutter preparation and offline UI gesture cases.'
