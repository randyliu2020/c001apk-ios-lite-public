@@ -0,0 +1,146 @@
+import 'package:flutter/material.dart';
+
+/// Gives the outer Scaffold the visible list's actual controller. Controllers
+/// remain owned by their pages; status-bar taps never invoke a refresh callback.
+class StatusBarScrollHost extends StatefulWidget {
+  const StatusBarScrollHost({super.key, required this.child});
+
+  final Widget child;
+
+  @override
+  State<StatusBarScrollHost> createState() => _StatusBarScrollHostState();
+}
+
+class _StatusBarScrollHostState extends State<StatusBarScrollHost> {
+  final _targets = <Object, ScrollController>{};
+  ScrollController? _controller;
+  bool _scheduled = false;
+
+  void _register(Object owner, ScrollController? controller) {
+    if (controller == null) {
+      _targets.remove(owner);
+    } else {
+      _targets[owner] = controller;
+    }
+    if (_scheduled) return;
+    _scheduled = true;
+    // Children register while building or unmounting. Update the ancestor only
+    // after every old/new visible branch has registered for this frame.
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      _scheduled = false;
+      if (!mounted) return;
+      final next = _targets.values.lastOrNull;
+      if (!identical(next, _controller)) {
+        setState(() => _controller = next);
+      }
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (Theme.of(context).platform != TargetPlatform.iOS) return widget.child;
+    return _StatusBarScrollScope(
+        active: true,
+        register: _register,
+        child: _controller == null
+            ? PrimaryScrollController.none(child: widget.child)
+            : PrimaryScrollController(
+                controller: _controller!,
+                // A different list must not attach itself to this controller.
+                automaticallyInheritForPlatforms: const {},
+                child: widget.child,
+              ),
+      );
+  }
+}
+
+/// Keep-alive destinations and nested categories only expose the visible list.
+class StatusBarScrollBranch extends StatelessWidget {
+  const StatusBarScrollBranch({
+    super.key,
+    required this.active,
+    required this.child,
+  });
+
+  final bool active;
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    final parent = _StatusBarScrollScope.maybeOf(context);
+    if (parent == null) return child;
+    return _StatusBarScrollScope(
+      active: parent.active && active,
+      register: parent.register,
+      child: child,
+    );
+  }
+}
+
+class StatusBarScrollTarget extends StatefulWidget {
+  const StatusBarScrollTarget({
+    super.key,
+    required this.controller,
+    required this.child,
+  });
+
+  final ScrollController? controller;
+  final Widget child;
+
+  @override
+  State<StatusBarScrollTarget> createState() => _StatusBarScrollTargetState();
+}
+
+class _StatusBarScrollTargetState extends State<StatusBarScrollTarget> {
+  _StatusBarScrollScope? _scope;
+
+  void _register() {
+    final scope = _StatusBarScrollScope.maybeOf(context);
+    if (_scope?.register != scope?.register) {
+      _scope?.register(this, null);
+    }
+    _scope = scope;
+    if (scope != null) {
+      scope.register(this, scope.active ? widget.controller : null);
+    }
+  }
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    _register();
+  }
+
+  @override
+  void didUpdateWidget(StatusBarScrollTarget oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    _register();
+  }
+
+  @override
+  void dispose() {
+    _scope?.register(this, null);
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.child;
+}
+
+class _StatusBarScrollScope extends InheritedWidget {
+  const _StatusBarScrollScope({
+    required this.active,
+    required this.register,
+    required super.child,
+  });
+
+  final bool active;
+  final void Function(Object, ScrollController?) register;
+
+  static _StatusBarScrollScope? maybeOf(BuildContext context) =>
+      context.dependOnInheritedWidgetOfExactType<_StatusBarScrollScope>();
+
+  @override
+  bool updateShouldNotify(_StatusBarScrollScope oldWidget) =>
+      active != oldWidget.active || register != oldWidget.register;
+}
