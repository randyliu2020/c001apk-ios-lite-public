diff --git a/apps/flutter/lib/logic/content_filter/content_filter_input_cache.dart b/apps/flutter/lib/logic/content_filter/content_filter_input_cache.dart
new file mode 100644
index 0000000..30a1001
--- /dev/null
+++ b/apps/flutter/lib/logic/content_filter/content_filter_input_cache.dart
@@ -0,0 +1,101 @@
+import 'dart:collection';
+
+import 'package:flutter/foundation.dart';
+
+import '../model/feed/datum.dart';
+import 'content_filter_projection.dart';
+import 'content_filter_rule.dart';
+
+typedef FilterInputProjector = FilterInput Function(Datum data,
+    {FilterScope? scope});
+
+/// Reuses parsing, never a filtering decision. Current rules and exceptions
+/// must still be evaluated by the caller, including while a rule save awaits IO.
+class ContentFilterInputCache {
+  ContentFilterInputCache({
+    this.maximumEntries = 1024,
+    this.maximumTextCharacters = 1024 * 1024,
+    FilterInputProjector? project,
+  }) : _project = project ?? ContentFilterProjection.inputOf;
+
+  final int maximumEntries;
+  final int maximumTextCharacters;
+  final FilterInputProjector _project;
+  final _entries = HashMap<Datum, _Entry>.identity();
+  int _textCharacters = 0;
+  int parses = 0;
+  int cacheHits = 0;
+  int get length => _entries.length;
+
+  FilterInput inputOf(Datum data, {required FilterScope scope}) {
+    final signature = _signature(data, scope);
+    final previous = _entries[data];
+    if (previous != null && listEquals(previous.signature, signature)) {
+      cacheHits++;
+      return previous.input;
+    }
+    if (previous != null) {
+      _entries.remove(data);
+      _textCharacters -= previous.textCharacters;
+    }
+    final input = _project(data, scope: scope);
+    parses++;
+    final characters = input.text.length +
+        input.topicIds.fold<int>(0, (sum, value) => sum + value.length) +
+        input.topicNames.fold<int>(0, (sum, value) => sum + value.length);
+    // Do not churn the entire cache when a long feed exceeds its budget.
+    // Already cached rows remain useful; unretained rows follow the old path.
+    if (_entries.length < maximumEntries &&
+        _textCharacters + characters <= maximumTextCharacters) {
+      _entries[data] = _Entry(signature, input, characters);
+      _textCharacters += characters;
+    }
+    return input;
+  }
+
+  void retain(Iterable<Datum> data) {
+    if (_entries.isEmpty) return;
+    final retained = HashSet<Datum>.identity()..addAll(data);
+    _entries.removeWhere((item, entry) {
+      if (retained.contains(item)) return false;
+      _textCharacters -= entry.textCharacters;
+      return true;
+    });
+  }
+
+  void clear() {
+    _entries.clear();
+    _textCharacters = 0;
+  }
+
+  // These are exactly the mutable fields read by inputOf(), before parsing.
+  // Nested topic values are copied into immutable records, so editing an
+  // existing RelationRow/TargetRow also invalidates the cached projection.
+  static List<Object?> _signature(Datum data, FilterScope scope) => [
+        scope,
+        data.entityType,
+        data.id,
+        data.entityId,
+        data.uid,
+        data.title,
+        data.url,
+        data.messageTitle,
+        data.message,
+        data.messageRawOutput,
+        data.tags,
+        data.ttitle,
+        if (data.targetRow case final target?)
+          ('target', target.id, target.title, target.url, target.entityType)
+        else
+          null,
+        for (final row in data.relationRows ?? [])
+          ('relation', row.id, row.title, row.url, row.entityType),
+      ];
+}
+
+class _Entry {
+  const _Entry(this.signature, this.input, this.textCharacters);
+  final List<Object?> signature;
+  final FilterInput input;
+  final int textCharacters;
+}
