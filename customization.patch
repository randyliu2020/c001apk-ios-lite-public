+      behavior: HitTestBehavior.translucent,
+      onPointerDown: _down,
+      onPointerMove: _move,
+      onPointerUp: _up,
+      onPointerCancel: _cancel,
+      // Keep this listener outside the moving image. It must still see a
+      // second finger in the exposed space above the translated gallery.
+      child: AnimatedBuilder(
+        animation: _offset,
+        child: RepaintBoundary(child: widget.child),
+        builder: (context, child) {
+          final distance = reduceMotion ? 0.0 : _offset.value;
+          final height = MediaQuery.sizeOf(context).height;
+          final progress = (distance / height).clamp(0.0, 1.0);
+          return Transform.translate(
+            key: const ValueKey('ios-image-dismiss-content'),
+            offset: Offset(0, distance),
+            child: Transform.scale(scale: 1 - 0.15 * progress, child: child),
+          );
+        },
+      ),
+    );
+  }
+}
