@@ -0,0 +1,185 @@
+import 'package:c001apk_flutter/components/adaptive_card_list.dart';
+import 'package:c001apk_flutter/components/masonry_section.dart';
+import 'package:c001apk_flutter/components/network_image.dart';
+import 'package:c001apk_flutter/components/image_load_probe.dart';
+import 'package:cached_network_image/cached_network_image.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  for (final sliver in [false, true]) {
+    testWidgets('phone list stays lazy without masonry sections ($sliver)',
+        (tester) async {
+      tester.view.devicePixelRatio = 3;
+      tester.view.physicalSize = const Size(1320, 2868);
+      addTearDown(tester.view.resetDevicePixelRatio);
+      addTearDown(tester.view.resetPhysicalSize);
+      final scroll = ScrollController();
+      final built = <int>{};
+      var structuralChecks = 0;
+      var footerBuilds = 0;
+      var count = 500;
+      late StateSetter update;
+      await tester.pumpWidget(MaterialApp(
+          home: Scaffold(body: StatefulBuilder(builder: (context, setState) {
+        update = setState;
+        Widget card(BuildContext context, int index) {
+          built.add(index);
+          return SizedBox(
+              key: ValueKey('phone-card-$index'),
+              height: 120,
+              child: Text('Card $index'));
+        }
+
+        bool structural(int index) {
+          structuralChecks++;
+          return index % 5 == 0;
+        }
+
+        final footer = Builder(builder: (_) {
+          footerBuilds++;
+          return const SizedBox(height: 40, child: Text('Pagination footer'));
+        });
+        return sliver
+            ? CustomScrollView(controller: scroll, slivers: [
+                AdaptiveCardList.sliver(
+                    itemCount: count,
+                    itemBuilder: card,
+                    isFullWidth: structural,
+                    footer: footer),
+              ])
+            : AdaptiveCardList(
+                controller: scroll,
+                itemCount: count,
+                itemBuilder: card,
+                isFullWidth: structural,
+                footer: footer);
+      }))));
+      await tester.pumpAndSettle();
+      expect(find.byType(MasonrySection), findsNothing);
+      expect(find.byType(SliverList), findsOneWidget);
+      expect(structuralChecks, 0,
+          reason: 'A single column must not scan all 500 rows into sections.');
+      expect(built.length, lessThan(20));
+      expect(footerBuilds, 0);
+      expect(tester.getSize(find.byKey(const ValueKey('phone-card-0'))).width,
+          420);
+      for (final offset in [400.0, 1400.0, 3000.0, 1400.0, 0.0]) {
+        scroll.jumpTo(offset);
+        await tester.pumpAndSettle();
+        expect(scroll.offset, closeTo(offset, 0.01));
+      }
+      expect(built.length, lessThan(60));
+      expect(footerBuilds, 0);
+      scroll.jumpTo(1400);
+      update(() => count = 520);
+      await tester.pumpAndSettle();
+      expect(scroll.offset, 1400);
+      expect(structuralChecks, 0);
+      expect(footerBuilds, 0);
+      scroll.jumpTo(scroll.position.maxScrollExtent);
+      await tester.pumpAndSettle();
+      expect(footerBuilds, 1);
+      expect(tester.takeException(), isNull);
+      await tester.pumpWidget(const SizedBox.shrink());
+      scroll.dispose();
+    });
+  }
+
+  Future<CachedNetworkImage> configuration(WidgetTester tester,
+      {required String url,
+      double? width,
+      double? height,
+      BoxFit? fit,
+      ImageWidgetBuilder? imageBuilder}) async {
+    late CachedNetworkImage result;
+    // Inspect the real widget configuration without starting HTTP/cache I/O.
+    await tester.pumpWidget(MaterialApp(
+        home: MediaQuery(
+      data: const MediaQueryData(devicePixelRatio: 3),
+      child: Builder(builder: (context) {
+        final widget = networkImage(url,
+            width: width,
+            height: height,
+            fit: fit,
+            imageBuilder: imageBuilder) as Builder;
+        result = (widget.builder(context) as ImageLoadProbe).child
+            as CachedNetworkImage;
+        return const SizedBox.shrink();
+      }),
+    )));
+    return result;
+  }
+
+  testWidgets('3x thumbnail decode keeps cover detail and the source URL',
+      (tester) async {
+    const landscape = 'https://image.coolapk.com/photo@6000x4000.jpg';
+    final wide = await configuration(tester,
+        url: landscape, width: 120, height: 120, fit: BoxFit.cover);
+    expect(wide.imageUrl, landscape);
+    expect(wide.memCacheWidth, isNull);
+    expect(wide.memCacheHeight, 360);
+    expect(wide.width, 120);
+    expect(wide.height, 120);
+    expect(wide.fit, BoxFit.cover);
+    final tall = await configuration(tester,
+        url: 'https://image.coolapk.com/photo@3000x6000.jpg',
+        width: 120,
+        height: 120,
+        fit: BoxFit.cover);
+    expect(tall.memCacheWidth, 360);
+    expect(tall.memCacheHeight, isNull);
+    final long = await configuration(tester,
+        url: 'https://image.coolapk.com/photo@3000x20000.jpg',
+        width: 120,
+        height: 293,
+        fit: BoxFit.fill);
+    expect(long.memCacheWidth, 360);
+    expect(long.memCacheHeight, 879);
+  });
+
+  testWidgets('avatars decode for display size without changing aspect ratio',
+      (tester) async {
+    final avatar = await configuration(tester,
+        url: 'https://example.com/avatar.jpg', width: 40, height: 40);
+    expect(avatar.memCacheWidth, 120);
+    expect(avatar.memCacheHeight, isNull);
+    final fitHeight = await configuration(tester,
+        url: 'https://example.com/photo.jpg',
+        width: double.infinity,
+        height: 90,
+        fit: BoxFit.fitHeight);
+    expect(fitHeight.memCacheWidth, isNull);
+    expect(fitHeight.memCacheHeight, 270);
+  });
+
+  testWidgets('unknown crop ratios and custom builders retain original decode',
+      (tester) async {
+    for (final url in [
+      'https://example.com/photo.jpg',
+      'https://image.coolapk.com/photo@0x4000.jpg',
+      'https://image.coolapk.com/photo@6000x4000.jpg!square',
+      'https://image.coolapk.com/photo@6000x4000.jpg?crop=square',
+    ]) {
+      final image = await configuration(tester,
+          url: url, width: 120, height: 120, fit: BoxFit.cover);
+      expect(image.memCacheWidth, isNull);
+      expect(image.memCacheHeight, isNull);
+    }
+    final unbounded = await configuration(tester,
+        url: 'https://image.coolapk.com/photo@6000x4000.jpg',
+        width: double.infinity,
+        height: 72,
+        fit: BoxFit.cover);
+    expect(unbounded.memCacheWidth, isNull);
+    expect(unbounded.memCacheHeight, isNull);
+    final custom = await configuration(tester,
+        url: 'https://example.com/photo.jpg',
+        width: 120,
+        height: 120,
+        fit: BoxFit.fill,
+        imageBuilder: (_, __) => const SizedBox());
+    expect(custom.memCacheWidth, isNull);
+    expect(custom.memCacheHeight, isNull);
+  });
+}
