diff --git a/apps/flutter/lib/components/image_load_probe.dart b/apps/flutter/lib/components/image_load_probe.dart
new file mode 100644
index 0000000..fe4c7dc
--- /dev/null
+++ b/apps/flutter/lib/components/image_load_probe.dart
@@ -0,0 +1,109 @@
+import 'package:flutter/material.dart';
+
+import '../logic/performance/performance_recorder.dart';
+
+/// Observes the same cached image stream as the displayed image. It neither
+/// changes the image key/codec nor issues a separate download. Collection ends
+/// at the first frame, so animated images are not kept alive by diagnostics.
+class ImageLoadProbe extends StatefulWidget {
+  const ImageLoadProbe({
+    super.key,
+    required this.provider,
+    required this.child,
+    this.metrics = const {},
+    this.recorder,
+  });
+
+  final ImageProvider provider;
+  final Widget child;
+  final Map<String, num> metrics;
+  final PerformanceRecorder? recorder;
+
+  @override
+  State<ImageLoadProbe> createState() => _ImageLoadProbeState();
+}
+
+class _ImageLoadProbeState extends State<ImageLoadProbe> {
+  ImageProvider? _observedProvider;
+  ImageStream? _stream;
+  ImageStreamListener? _listener;
+  PerformanceSpan? _span;
+  PerformanceRecorder? _recorder;
+  DisposableBuildContext<_ImageLoadProbeState>? _loadContext;
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    _observe();
+  }
+
+  @override
+  void didUpdateWidget(ImageLoadProbe oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.provider != widget.provider ||
+        oldWidget.recorder != widget.recorder) {
+      _finish(const {'cancelled': 1});
+      _observedProvider = null;
+    }
+    _observe();
+  }
+
+  void _observe() {
+    final recorder = widget.recorder ?? PerformanceRecorder.instance;
+    if (!recorder.isRecording || _observedProvider == widget.provider) return;
+    _finish(const {'cancelled': 1});
+    _observedProvider = widget.provider;
+    _recorder = recorder;
+    _span =
+        recorder.begin(PerformanceOperation.imageLoad, metrics: widget.metrics);
+    recorder.addListener(_recordingChanged);
+    _loadContext = DisposableBuildContext(this);
+    // Preserve Image's fast-scroll deferral rather than eagerly decoding images
+    // that the user may scroll past before they become visible.
+    _stream = ScrollAwareImageProvider(
+      context: _loadContext!,
+      imageProvider: widget.provider,
+    ).resolve(createLocalImageConfiguration(context));
+    _listener = ImageStreamListener((info, synchronous) {
+      _finish({
+        'success': 1,
+        'width': info.image.width,
+        'height': info.image.height,
+        'synchronous': synchronous ? 1 : 0,
+      });
+      info.dispose();
+    }, onError: (Object error, StackTrace? stack) {
+      // Exception text and URLs must never be included in reports.
+      _finish(const {'failed': 1});
+    });
+    _stream!.addListener(_listener!);
+  }
+
+  void _recordingChanged() {
+    if (_recorder?.isRecording != true) {
+      _finish(const {'cancelled': 1});
+      _observedProvider = null;
+    }
+  }
+
+  void _finish(Map<String, num> metrics) {
+    _span?.finish(metrics: metrics);
+    _span = null;
+    _recorder?.removeListener(_recordingChanged);
+    _recorder = null;
+    if (_listener != null) _stream?.removeListener(_listener!);
+    _listener = null;
+    _stream = null;
+    _loadContext?.dispose();
+    _loadContext = null;
+  }
+
+  @override
+  void dispose() {
+    _finish(const {'cancelled': 1});
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) => widget.child;
+}
diff --git a/apps/flutter/lib/components/ios_gallery_paging.dart b/apps/flutter/lib/components/ios_gallery_paging.dart
new file mode 100644
index 0000000..a4e701a
--- /dev/null
+++ b/apps/flutter/lib/components/ios_gallery_paging.dart
@@ -0,0 +1,136 @@
+import 'dart:math' as math;
+
+import 'package:flutter/gestures.dart';
+import 'package:flutter/material.dart';
+
+/// Gives a contained image's horizontal drag to the gallery before PhotoView's
+/// scale recognizer can claim a coalesced first move. Zoomed images keep their
+/// own pan/scale recognizer and the screen edge keeps the route back gesture.
+class IOSGalleryPaging extends StatefulWidget {
+  const IOSGalleryPaging({
+    super.key,
+    required this.controller,
+    required this.canPage,
+    required this.child,
+  });
+
+  final PageController controller;
+  final bool Function() canPage;
+  final Widget child;
+
+  @override
+  State<IOSGalleryPaging> createState() => _IOSGalleryPagingState();
+}
+
+class _GalleryDragRecognizer extends HorizontalDragGestureRecognizer {
+  _GalleryDragRecognizer({super.debugOwner}) {
+    onlyAcceptDragOnThreshold = true;
+  }
+
+  void rejectPending() => resolve(GestureDisposition.rejected);
+}
+
+class _IOSGalleryPagingState extends State<IOSGalleryPaging> {
+  late final _recognizer = _GalleryDragRecognizer(debugOwner: this)
+    ..onStart = _start
+    ..onUpdate = _update
+    ..onEnd = _end
+    ..onCancel = _cancelDrag;
+  final _pointers = <int>{};
+  Drag? _drag;
+  bool _blocked = false;
+
+  bool get _isCurrent {
+    final route = ModalRoute.of(context);
+    return route != null &&
+        route.isCurrent &&
+        route.animation?.status == AnimationStatus.completed &&
+        !(route.navigator?.userGestureInProgress ?? true);
+  }
+
+  void _cancelDrag() {
+    final drag = _drag;
+    _drag = null;
+    if (widget.controller.hasClients) drag?.cancel();
+  }
+
+  void _abort() {
+    _blocked = true;
+    _recognizer.rejectPending();
+    _cancelDrag();
+  }
+
+  void _down(PointerDownEvent event) {
+    if (event.kind != PointerDeviceKind.touch) return;
+    _pointers.add(event.pointer);
+    if (_pointers.length != 1) {
+      _abort();
+      return;
+    }
+    final box = context.findRenderObject()! as RenderBox;
+    final local = box.globalToLocal(event.position);
+    final rtl = Directionality.of(context) == TextDirection.rtl;
+    final padding = MediaQuery.paddingOf(context);
+    final edge = math.max(24.0, rtl ? padding.right : padding.left);
+    final fromEdge = (rtl ? box.size.width - local.dx : local.dx) <= edge;
+    _blocked = fromEdge || !_isCurrent || !widget.canPage();
+    if (!_blocked) _recognizer.addPointer(event);
+  }
+
+  void _release(PointerEvent event) {
+    _pointers.remove(event.pointer);
+    if (_pointers.isEmpty) _blocked = false;
+  }
+
+  void _start(DragStartDetails details) {
+    if (_blocked ||
+        _pointers.length != 1 ||
+        !_isCurrent ||
+        !widget.controller.hasClients ||
+        !widget.canPage()) return;
+    // Retain PageView's existing axis direction, page snapping and physics.
+    _drag = widget.controller.position.drag(details, () => _drag = null);
+  }
+
+  void _update(DragUpdateDetails details) {
+    if (_blocked || _pointers.length != 1 || !_isCurrent) {
+      _abort();
+      return;
+    }
+    _drag?.update(details);
+  }
+
+  void _end(DragEndDetails details) {
+    final drag = _drag;
+    _drag = null;
+    drag?.end(details);
+  }
+
+  @override
+  void dispose() {
+    _cancelDrag();
+    _recognizer.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (Theme.of(context).platform != TargetPlatform.iOS) return widget.child;
+    return Stack(fit: StackFit.expand, children: [
+      widget.child,
+      Positioned.fill(
+        // Translucency adds this listener first without blocking PhotoView's
+        // taps, long presses, pinch gestures or the underlying PageView.
+        child: Listener(
+          behavior: HitTestBehavior.translucent,
+          onPointerDown: _down,
+          onPointerUp: _release,
+          onPointerCancel: (event) {
+            _abort();
+            _release(event);
+          },
+        ),
+      ),
+    ]);
+  }
+}
diff --git a/apps/flutter/lib/components/ios_image_dismiss.dart b/apps/flutter/lib/components/ios_image_dismiss.dart
new file mode 100644
index 0000000..080e55e
--- /dev/null
+++ b/apps/flutter/lib/components/ios_image_dismiss.dart
@@ -0,0 +1,212 @@
+import 'dart:async';
+import 'dart:math' as math;
+
+import 'package:flutter/gestures.dart';
+import 'package:flutter/material.dart';
+
+/// Observes a contained photo's downward drag without competing with the
+/// gallery's scale recognizer. A zoomed photo always keeps its pan gesture.
+class IOSImageDismiss extends StatefulWidget {
+  const IOSImageDismiss({
+    super.key,
+    required this.canDismiss,
+    required this.child,
+    this.onDraggingChanged,
+  });
+
+  final bool Function() canDismiss;
+  final ValueChanged<bool>? onDraggingChanged;
+  final Widget child;
+
+  @override
+  State<IOSImageDismiss> createState() => _IOSImageDismissState();
+}
+
+class _IOSImageDismissState extends State<IOSImageDismiss>
+    with SingleTickerProviderStateMixin {
+  late final _offset = AnimationController.unbounded(vsync: this);
+  final _pointers = <int>{};
+  int? _pointer;
+  Offset? _origin;
+  VelocityTracker? _velocity;
+  bool _candidate = false;
+  bool _blocked = false;
+  bool _dragging = false;
+  bool _committing = false;
+
+  bool get _canDismiss {
+    final route = ModalRoute.of(context);
+    return Theme.of(context).platform == TargetPlatform.iOS &&
+        !_committing &&
+        route != null &&
+        route.isCurrent &&
+        !route.isFirst &&
+        route.popDisposition == RoutePopDisposition.pop &&
+        !route.willHandlePopInternally &&
+        route.animation?.status == AnimationStatus.completed &&
+        !(route.navigator?.userGestureInProgress ?? true) &&
+        widget.canDismiss();
+  }
+
+  void _setDragging(bool value) {
+    if (_dragging == value) return;
+    _dragging = value;
+    widget.onDraggingChanged?.call(value);
+  }
+
+  void _restore() {
+    _setDragging(false);
+    if (MediaQuery.disableAnimationsOf(context)) {
+      _offset.value = 0;
+    } else if (_offset.value != 0) {
+      unawaited(_offset.animateTo(0,
+          duration: const Duration(milliseconds: 180),
+          curve: Curves.easeOutCubic));
+    }
+  }
+
+  void _abort() {
+    _blocked = true;
+    _candidate = false;
+    _restore();
+  }
+
+  void _down(PointerDownEvent event) {
+    if (event.kind != PointerDeviceKind.touch) return;
+    _pointers.add(event.pointer);
+    if (_pointers.length != 1) {
+      _abort();
+      return;
+    }
+    _pointer = event.pointer;
+    _origin = event.position;
+    _velocity = VelocityTracker.withKind(event.kind)
+      ..addPosition(event.timeStamp, event.position);
+    final box = context.findRenderObject()! as RenderBox;
+    final local = box.globalToLocal(event.position);
+    final rtl = Directionality.of(context) == TextDirection.rtl;
+    final padding = MediaQuery.paddingOf(context);
+    final edge = math.max(24.0, rtl ? padding.right : padding.left);
+    final fromLeadingEdge =
+        (rtl ? box.size.width - local.dx : local.dx) <= edge;
+    // Leave the screen edge to the route's interactive back gesture.
+    _blocked = fromLeadingEdge || _offset.isAnimating || !_canDismiss;
+    _candidate = !_blocked;
+  }
+
+  void _move(PointerMoveEvent event) {
+    if (event.pointer != _pointer || _blocked || !_candidate) return;
+    _velocity?.addPosition(event.timeStamp, event.position);
+    if (!_canDismiss || _pointers.length != 1) {
+      _abort();
+      return;
+    }
+    final delta = event.position - _origin!;
+    if (!_dragging) {
+      if (delta.distance <= kTouchSlop) return;
+      // Lock the first direction. A horizontal swipe or upward pan cannot
+      // turn into an accidental dismissal later in the same touch sequence.
+      if (delta.dy <= 0 || delta.dy <= delta.dx.abs() * 1.25) {
+        _abort();
+        return;
+      }
+      _setDragging(true);
+    }
+    _offset.value = math.max(0.0, delta.dy - kTouchSlop);
+  }
+
+  void _up(PointerUpEvent event) {
+    if (!_pointers.remove(event.pointer)) return;
+    if (event.pointer == _pointer) {
+      _velocity?.addPosition(event.timeStamp, event.position);
+      final velocity = _velocity?.getVelocity().pixelsPerSecond.dy ?? 0;
+      final height = context.size?.height ?? 800;
+      final threshold = math.min(180.0, height * 0.22);
+      final close = _dragging &&
+          !_blocked &&
+          _canDismiss &&
+          velocity > -300 &&
+          (_offset.value >= threshold ||
+              (_offset.value >= 64 && velocity >= 900));
+      _candidate = false;
+      if (close) {
+        unawaited(_dismiss());
+      } else {
+        _restore();
+      }
+    }
+    _resetWhenReleased();
+  }
+
+  Future<void> _dismiss() async {
+    // maybePop preserves PopScope/legacy route guards. A dialog or a new route
+    // must never be popped instead of the image page we started dragging.
+    if (!_canDismiss) {
+      _restore();
+      return;
+    }
+    _committing = true;
+    _setDragging(false);
+    final navigator = Navigator.of(context);
+    final handled = await navigator.maybePop();
+    if (!mounted) return;
+    _committing = false;
+    if (!handled || ModalRoute.of(context)?.isCurrent == true) _restore();
+  }
+
+  void _cancel(PointerCancelEvent event) {
+    if (!_pointers.remove(event.pointer)) return;
+    _abort();
+    _resetWhenReleased();
+  }
+
+  void _resetWhenReleased() {
+    if (_pointers.isNotEmpty) return;
+    _pointer = null;
+    _origin = null;
+    _velocity = null;
+    _candidate = false;
+    _blocked = false;
+  }
+
+  @override
+  void dispose() {
+    _offset.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (Theme.of(context).platform != TargetPlatform.iOS) return widget.child;
+    final current = ModalRoute.isCurrentOf(context) ?? false;
+    if (!current && (_candidate || _dragging)) {
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        if (mounted) _abort();
+      });
+    }
