diff --git a/apps/flutter/test/content_filter/projection_disabled_test.dart b/apps/flutter/test/content_filter/projection_disabled_test.dart
new file mode 100644
--- /dev/null
+++ b/apps/flutter/test/content_filter/projection_disabled_test.dart
@@ -0,0 +1,158 @@
+import 'dart:io';
+
+import 'package:c001apk_flutter/logic/content_filter/app_content_filter.dart';
+import 'package:c001apk_flutter/logic/content_filter/content_filter_projection.dart';
+import 'package:c001apk_flutter/logic/content_filter/content_filter_rule.dart';
+import 'package:c001apk_flutter/logic/content_filter/content_filter_service.dart';
+import 'package:c001apk_flutter/logic/model/feed/datum.dart';
+import 'package:c001apk_flutter/utils/storage_util.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:hive/hive.dart';
+
+// Reading the body is observable without timing thresholds or parser hooks.
+// A disabled filter must leave both HTML and article JSON untouched.
+class _ObservedBody extends Datum {
+  _ObservedBody({int super.uid = 7, super.tags})
+      : super(
+            entityType: 'feed',
+            id: 42,
+            message: '<p>projection-regression-marker</p>',
+            messageRawOutput: '[{"type":"text","message":"article"}]');
+
+  int bodyReads = 0;
+  int articleReads = 0;
+
+  @override
+  String? get message {
+    bodyReads++;
+    return super.message;
+  }
+
+  @override
+  String? get messageRawOutput {
+    articleReads++;
+    return super.messageRawOutput;
+  }
+}
+
+const _rule = FilterRule(
+    id: 'personal.projection-regression',
+    reason: 'Projection regression fixture',
+    kind: FilterRuleKind.text,
+    groups: [
+      ['projection-regression-marker']
+    ]);
+
+void main() {
+  late Directory temporary;
+  late Box<dynamic> box;
+  late ContentFilterService service;
+  final now = DateTime.utc(2026, 11, 16);
+
+  setUpAll(() async {
+    temporary = await Directory.systemTemp.createTemp('projection-disabled-');
+    Hive.init(temporary.path);
+    GStorage.blackList = await Hive.openBox('blackList');
+    box = await Hive.openBox('projectionDisabled');
+  });
+
+  setUp(() async {
+    await box.clear();
+    await GStorage.blackList.clear();
+    // Keep this unit test offline even when it enables the real service.
+    await box.put('lastCheckedAt', now.toIso8601String());
+    service = ContentFilterService(box, now: () => now);
+    AppContentFilter.service = service;
+  });
+
+  tearDown(() {
+    service.dispose();
+    AppContentFilter.service = null;
+  });
+
+  tearDownAll(() async {
+    await Hive.close();
+    await temporary.delete(recursive: true);
+  });
+
+  test('disabled card filtering does not read HTML or article bodies', () {
+    final data = _ObservedBody();
+    expect(service.enabled, isFalse);
+    for (var build = 0; build < 20; build++) {
+      expect(ContentFilterProjection.match(data), isNull);
+    }
+    expect(data.bodyReads, 0);
+    expect(data.articleReads, 0);
+  });
+
+  test('missing service leaves card bodies untouched', () {
+    AppContentFilter.service = null;
+    final data = _ObservedBody();
+    expect(ContentFilterProjection.match(data), isNull);
+    expect(data.bodyReads, 0);
+    expect(data.articleReads, 0);
+  });
+
+  test('legacy author and topic blocks survive disabled or missing service',
+      () async {
+    await GStorage.blackList.put(BlackListBoxKey.userBlackList, ['8']);
+    await GStorage.blackList
+        .put(BlackListBoxKey.topicBlackList, ['legacy-topic']);
+    for (final current in <ContentFilterService?>[service, null]) {
+      AppContentFilter.service = current;
+      final author = _ObservedBody(uid: 8);
+      final topic = _ObservedBody(tags: 'legacy-topic');
+      expect(ContentFilterProjection.match(author)?.ruleId, 'legacy.user:8');
+      expect(ContentFilterProjection.match(topic)?.ruleId,
+          'legacy.topic:legacy-topic');
+      expect(author.bodyReads + author.articleReads, 0);
+      expect(topic.bodyReads + topic.articleReads, 0);
+    }
+  });
+
+  test('toggling the service takes effect on the same card immediately',
+      () async {
+    await service.addPersonalRule(_rule);
+    final data = _ObservedBody();
+    expect(ContentFilterProjection.match(data), isNull);
+    expect(data.bodyReads, 0);
+
+    await service.setEnabled(true);
+    expect(ContentFilterProjection.match(data)?.ruleId, _rule.id);
+    expect(data.bodyReads, greaterThan(0));
+    expect(data.articleReads, greaterThan(0));
+    final reads = (data.bodyReads, data.articleReads);
+
+    final saving = service.setEnabled(false);
+    expect(ContentFilterProjection.match(data), isNull);
+    expect((data.bodyReads, data.articleReads), reads);
+    await saving;
+
+    await service.setEnabled(true);
+    expect(ContentFilterProjection.match(data)?.ruleId, _rule.id);
+  });
+
+  test('enabled cards use current rules, exceptions and edited content',
+      () async {
+    await service.setEnabled(true);
+    final data = _ObservedBody();
+    expect(ContentFilterProjection.match(data), isNull);
+    await service.addPersonalRule(_rule);
+    expect(ContentFilterProjection.match(data)?.ruleId, _rule.id);
+
+    final disabling = service.setRuleDisabled(_rule.id, true);
+    expect(ContentFilterProjection.match(data), isNull);
+    await disabling;
+    await service.setRuleDisabled(_rule.id, false);
+    expect(ContentFilterProjection.match(data)?.ruleId, _rule.id);
+
+    final allowing = service.setContentAllowed('feed:42', true);
+    expect(ContentFilterProjection.match(data), isNull);
+    await allowing;
+    await service.setContentAllowed('feed:42', false);
+    expect(ContentFilterProjection.match(data)?.ruleId, _rule.id);
+
+    data.message = '<p>Ordinary edited content</p>';
+    expect(ContentFilterProjection.match(data), isNull);
+  });
+}
