+import 'dart:io';
+
+import 'package:c001apk_flutter/logic/content_filter/app_content_filter.dart';
+import 'package:c001apk_flutter/logic/content_filter/content_filter_input_cache.dart';
+import 'package:c001apk_flutter/logic/content_filter/content_filter_rule.dart';
+import 'package:c001apk_flutter/logic/content_filter/content_filter_service.dart';
+import 'package:c001apk_flutter/logic/model/feed/datum.dart';
+import 'package:c001apk_flutter/logic/model/feed/relation_row.dart';
+import 'package:c001apk_flutter/logic/model/feed/target_row.dart';
+import 'package:c001apk_flutter/logic/performance/performance_recorder.dart';
+import 'package:c001apk_flutter/logic/state/loading_state.dart';
+import 'package:c001apk_flutter/pages/common/common_controller.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:hive/hive.dart';
+
+class _Controller extends CommonController {
+  final responses = <LoadingState>[];
+  final requests = <(int, String?, String?)>[];
+
+  @override
+  Future<LoadingState> customGetData() async {
+    requests.add((page, firstItem, lastItem));
+    return responses.removeAt(0);
+  }
+}
+
+class _CustomUniqueController extends _Controller {
+  final received = <List<Datum>>[];
+
+  @override
+  List<Datum>? handleUnique(List<Datum> dataList) {
+    received.add([...dataList]);
+    return dataList.reversed.toList();
+  }
+}
+
+class _NoFilterController extends _Controller {
+  @override
+  bool get supportsContentFilter => false;
+}
+
+Datum _feed(int id, {int uid = 7}) =>
+    Datum(id: id, entityType: 'feed', uid: uid, message: '<p>普通技术内容 $id</p>');
+
+List<Datum> _visible(CommonController controller) =>
+    List<Datum>.from((controller.loadingState.value as Success).response);
+
+List<Map> _filterEvents() =>
+    (PerformanceRecorder.instance.snapshot()['events'] as List)
+        .cast<Map>()
+        .where((event) => event['operation'] == 'pageFilter')
+        .map((event) => event['metrics'] as Map)
+        .toList();
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory temporary;
+  late Box<dynamic> box;
+  setUpAll(() async {
+    temporary = await Directory.systemTemp.createTemp('pagination-perf-');
+    Hive.init(temporary.path);
+    box = await Hive.openBox('paginationPerformanceFilter');
+  });
+  setUp(() async {
+    await box.clear();
+    await box.put('enabled', true);
+    AppContentFilter.service = ContentFilterService(box);
+    PerformanceRecorder.instance.clear();
+  });
+  tearDown(() {
+    PerformanceRecorder.instance.clear();
+    AppContentFilter.service?.dispose();
+    AppContentFilter.service = null;
+  });
+  tearDownAll(() async {
+    await box.close();
+    await temporary.delete(recursive: true);
+  });
+
+  test('appending 20 rows parses only 20 new inputs after 500 retained rows',
+      () {
+    final controller = _Controller();
+    addTearDown(controller.onClose);
+    PerformanceRecorder.instance.start();
+    controller.publishItems(List.generate(500, _feed));
+    final previous = (controller.loadingState.value as Success).response;
+    controller.publishItems(List.generate(20, (index) => _feed(500 + index)),
+        append: true);
+    final samples = _filterEvents();
+    expect(samples[0]['parsed'], 500);
+    expect(samples[1]['processed'], 520);
+    expect(samples[1]['parsed'], 20);
+    expect(samples[1]['cache_hits'], 500);
+    expect(previous, hasLength(500));
+    expect(_visible(controller), hasLength(520));
+  });
+
+  test('refresh and reset release parsing cache; disabled filters do not parse',
+      () async {
+    final controller = _Controller();
+    addTearDown(controller.onClose);
+    final rows = List.generate(3, _feed);
+    PerformanceRecorder.instance.start();
+    controller.publishItems(rows);
+    controller.publishItems(rows);
+    expect(_filterEvents().last['parsed'], 3);
+    controller.onReset();
+    controller.publishItems([_feed(4)], append: true);
+    expect(_filterEvents().last['parsed'], 4);
+    await AppContentFilter.service!.setEnabled(false);
+    controller.publishItems([_feed(5)], append: true);
+    expect(_filterEvents().last['parsed'], 0);
+    expect(_visible(controller), hasLength(5));
+  });
+
+  test(
+      'rules, per-page reveal and changed authors take effect with cached input',
+      () async {
+    final controller = _Controller();
+    addTearDown(controller.onClose);
+    final hidden = _feed(1, uid: 1007278);
+    final visible = _feed(2);
+    controller.publishItems([hidden, visible]);
+    expect(_visible(controller).map((row) => row.id), [2]);
+    await AppContentFilter.service!
+        .setRuleDisabled('author.partner-showcase.1007278', true);
+    expect(_visible(controller).map((row) => row.id), [1, 2]);
+    await AppContentFilter.service!
+        .setRuleDisabled('author.partner-showcase.1007278', false);
+    expect(_visible(controller).map((row) => row.id), [2]);
+    controller.revealItem(hidden);
+    expect(_visible(controller).map((row) => row.id), [1, 2]);
+    controller.onReset();
+    visible.uid = 1007278;
+    controller.publishItems([_feed(3)], append: true);
+    expect(_visible(controller).map((row) => row.id), [3]);
+  });
+
+  test(
+      'filtered comments preserve their place and duplicate IDs preserve first',
+      () {
+    final controller = _Controller();
+    addTearDown(controller.onClose);
+    final hidden = _feed(1, uid: 1007278)..entityType = 'feed_reply';
+    final original = _feed(2);
+    controller.publishItems([hidden, original]);
+    controller.publishItems([_feed(2)..message = 'duplicate', _feed(3)],
+        append: true);
+    expect(_visible(controller), [hidden, original, controller.rawItems.last]);
+    expect(controller.filteredItems, [hidden]);
+    expect(controller.rawItems[1].message, original.message);
+  });
+
+  test('replacement does not mutate the caller list while deduplicating', () {
+    final controller = _Controller();
+    addTearDown(controller.onClose);
+    final source = List<Datum>.unmodifiable([_feed(1), _feed(1), _feed(2)]);
+    controller.publishItems(source);
+    expect(source, hasLength(3));
+    expect(_visible(controller).map((row) => row.id), [1, 2]);
+  });
+
+  test(
+      'custom deduplication sees all rows and can reorder or retain duplicates',
+      () {
+    final controller = _CustomUniqueController();
+    addTearDown(controller.onClose);
+    controller.publishItems([_feed(1), _feed(2)]);
+    controller.publishItems([_feed(2), _feed(3)], append: true);
+    expect(controller.received.last.map((row) => row.id), [2, 1, 2, 3]);
+    expect(_visible(controller).map((row) => row.id), [3, 2, 1, 2]);
+  });
+
+  test(
+      'unfiltered conversation append respects directly updated published data',
+      () {
+    final controller = _NoFilterController();
+    addTearDown(controller.onClose);
+    controller.publishItems([_feed(1), _feed(2)]);
+    controller.loadingState.value =
+        LoadingState.success([controller.rawItems[1]]);
+    controller.publishItems([_feed(3)], append: true);
+    expect(_visible(controller).map((row) => row.id), [2, 3]);
+  });
+
+  test('server cursors and automatic hidden-page traversal remain unchanged',
+      () async {
+    final controller = _Controller();
+    addTearDown(controller.onClose);
+    controller.responses.addAll([
+      Success([_feed(1, uid: 1007278)],
+          firstItem: 'server-first', lastItem: 'server-hidden-tail'),
+      Success([_feed(2), _feed(3, uid: 1007278)],
+          lastItem: 'server-second-tail'),
+    ]);
+    PerformanceRecorder.instance.start();
+    await controller.onGetData();
+    expect(controller.requests,
+        [(1, null, null), (2, 'server-first', 'server-hidden-tail')]);
+    expect(controller.firstItem, 'server-first');
+    expect(controller.lastItem, 'server-second-tail');
+    expect(controller.page, 3);
+    expect(controller.rawItems.map((row) => row.id), [1, 2, 3]);
+    expect(_visible(controller).map((row) => row.id), [2]);
+    final events = PerformanceRecorder.instance.snapshot()['events'] as List;
+    expect(events.where((event) => event['operation'] == 'pageFetch'),
+        hasLength(2));
+  });
+
+  test('cache invalidates mutable text, identity, topic links and article data',
+      () {
+    final cache = ContentFilterInputCache();
+    final row = _feed(1)
+      ..relationRows = [RelationRow(id: 2, title: 'Old', entityType: 'topic')]
+      ..targetRow = TargetRow(id: 3, title: 'Target', entityType: 'topic');
+    FilterInput input() => cache.inputOf(row, scope: FilterScope.feed);
+    final first = input();
+    expect(identical(input(), first), isTrue);
+    row.message = '<p>Changed</p>';
+    expect(input().text, contains('Changed'));
+    row.relationRows!.first.title = 'New';
+    expect(input().topicNames, contains('New'));
+    expect(input().topicNames, isNot(contains('Old')));
+    row.targetRow!.id = 8;
+    expect(input().topicIds, contains('8'));
+    row.id = null;
+    row.entityId = 'fallback';
+    expect(input().id, 'fallback');
+    row.id = 'null';
+    expect(input().id, 'null');
+    row.messageRawOutput = '[{"type":"text","message":"Article"}]';
+    expect(input().text, contains('Article'));
+    row.tags = 'Tagged';
+    expect(input().topicNames, contains('Tagged'));
+  });
+
+  test('cache is bounded and removed items are released without retaining text',
+      () {
+    final cache =
+        ContentFilterInputCache(maximumEntries: 2, maximumTextCharacters: 100);
+    final rows = [_feed(1), _feed(2), _feed(3)];
+    for (final row in rows) {
+      cache.inputOf(row, scope: FilterScope.feed);
+    }
+    expect(cache.length, 2);
+    final before = cache.parses;
+    cache.inputOf(rows[0], scope: FilterScope.feed);
+    expect(cache.parses, before);
+    cache.retain([rows[1]]);
+    expect(cache.length, 1);
+    cache.inputOf(_feed(4)..message = 'x' * 200, scope: FilterScope.feed);
+    expect(cache.length, 1);
+    cache.clear();
+    expect(cache.length, 0);
+  });
+}
