diff --git a/apps/flutter/lib/pages/settings/performance_page.dart b/apps/flutter/lib/pages/settings/performance_page.dart
new file mode 100644
index 0000000..fb42e22
--- /dev/null
+++ b/apps/flutter/lib/pages/settings/performance_page.dart
@@ -0,0 +1,136 @@
+import 'dart:convert';
+
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:share_plus/share_plus.dart';
+
+import '../../logic/performance/performance_recorder.dart';
+
+class PerformancePage extends StatefulWidget {
+  const PerformancePage({super.key, this.recorder});
+
+  final PerformanceRecorder? recorder;
+
+  @override
+  State<PerformancePage> createState() => _PerformancePageState();
+}
+
+class _PerformancePageState extends State<PerformancePage> {
+  PerformanceRecorder get _recorder =>
+      widget.recorder ?? PerformanceRecorder.instance;
+  bool _exporting = false;
+
+  Future<void> _export(BuildContext buttonContext, {bool copy = false}) async {
+    _recorder.stop();
+    setState(() => _exporting = true);
+    try {
+      final report = _recorder.exportJson();
+      if (copy) {
+        await Clipboard.setData(ClipboardData(text: report));
+        if (mounted) {
+          ScaffoldMessenger.of(context)
+              .showSnackBar(const SnackBar(content: Text('性能记录已复制')));
+        }
+      } else {
+        final box = buttonContext.findRenderObject();
+        await Share.shareXFiles(
+          [XFile.fromData(utf8.encode(report), mimeType: 'application/json')],
+          fileNameOverrides: ['c001apk-performance.json'],
+          subject: '酷安浏览性能记录',
+          sharePositionOrigin: box is RenderBox && box.hasSize
+              ? box.localToGlobal(Offset.zero) & box.size
+              : null,
+        );
+      }
+    } catch (_) {
+      if (mounted) {
+        ScaffoldMessenger.of(context)
+            .showSnackBar(const SnackBar(content: Text('导出失败，可以尝试复制记录')));
+      }
+    } finally {
+      if (mounted) setState(() => _exporting = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+        appBar: AppBar(title: const Text('浏览性能记录')),
+        body: SafeArea(
+          top: false,
+          child: ListenableBuilder(
+            listenable: _recorder,
+            builder: (context, _) {
+              final report = _recorder.snapshot();
+              final hasData = (report['eventCount'] as int) > 0 ||
+                  (report['frameCount'] as int) > 0;
+              final operations = report['operations'] as Map;
+              int count(String name) =>
+                  (operations[name] as Map?)?['count'] as int? ?? 0;
+              return ListView(
+                padding: const EdgeInsets.all(16),
+                children: [
+                  const Text('开启后返回首页，像平时一样刷帖。遇到卡顿后回到这里停止，'
+                      '导出记录即可帮助定位。建议分别记录首次浏览和回刷同一段内容。'),
+                  const SizedBox(height: 12),
+                  SwitchListTile.adaptive(
+                    contentPadding: EdgeInsets.zero,
+                    title: const Text('记录浏览性能'),
+                    subtitle: const Text('最长 5 分钟；重新开始会替换上一份记录'),
+                    value: _recorder.isRecording,
+                    onChanged: _exporting
+                        ? null
+                        : (enabled) =>
+                            enabled ? _recorder.start() : _recorder.stop(),
+                  ),
+                  const Text('仅在本机临时保存耗时和数量，不包含账号、帖子内容或图片链接，'
+                      '不会自动上传。关闭应用后记录不保留。'),
+                  const SizedBox(height: 24),
+                  Text(_recorder.isRecording ? '正在记录' : '记录已停止',
+                      style: Theme.of(context).textTheme.titleMedium),
+                  const SizedBox(height: 8),
+                  Text('已记录 ${report['frameCount']} 帧 · '
+                      '${count('pageFetch')} 次分页获取 · '
+                      '${count('pagePublish')} 次列表更新 · '
+                      '${count('imageLoad')} 次图片准备'),
+                  const SizedBox(height: 8),
+                  Text('单阶段超过 8.33 毫秒：${report['framesOver8333us']} 帧\n'
+                      '单阶段超过 16.67 毫秒：${report['framesOver16667us']} 帧'),
+                  const SizedBox(height: 8),
+                  const Text('这些数量用于排查耗时，不等于实际帧率或掉帧数。'
+                      '图片准备包含下载、缓存等待和解码；耗时长不一定会造成滚动卡顿。'),
+                  const SizedBox(height: 12),
+                  Wrap(spacing: 8, runSpacing: 8, children: [
+                    OutlinedButton.icon(
+                      onPressed: () => setState(() {}),
+                      icon: const Icon(Icons.refresh),
+                      label: const Text('刷新统计'),
+                    ),
+                    Builder(
+                        builder: (buttonContext) => FilledButton.icon(
+                              onPressed: hasData && !_exporting
+                                  ? () => _export(buttonContext)
+                                  : null,
+                              icon: const Icon(Icons.ios_share),
+                              label: const Text('停止并导出'),
+                            )),
+                    TextButton(
+                      onPressed: hasData && !_exporting
+                          ? () => _export(context, copy: true)
+                          : null,
+                      child: const Text('停止并复制'),
+                    ),
+                    TextButton(
+                      onPressed: _exporting ? null : _recorder.clear,
+                      child: const Text('清空记录'),
+                    ),
+                  ]),
+                  const SizedBox(height: 12),
+                  const Text('统计仅在本页刷新，不在刷帖时持续刷新显示。'
+                      '详细记录有数量上限，同时保留整段统计和较慢帧，避免长期占用内存。'),
+                ],
+              );
+            },
+          ),
+        ),
+      );
+}
