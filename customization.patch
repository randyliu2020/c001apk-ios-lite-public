+Finder _paragraph(Key key) =>
+    find.descendant(of: find.byKey(key), matching: find.byType(RichText));
+
+List<TextStyle> _styles(InlineSpan span, [TextStyle? inherited]) {
+  if (span is! TextSpan) return [];
+  final style = (inherited ?? const TextStyle()).merge(span.style);
+  return [
+    if (span.text?.isNotEmpty == true) style,
+    for (final child in span.children ?? <InlineSpan>[])
+      ..._styles(child, style),
+  ];
+}
+
+Map<String, Object?> _styleShape(TextStyle style) => {
+      'fontSize': style.fontSize,
+      'fontFamily': style.fontFamily,
+      'fontFamilyFallback': style.fontFamilyFallback,
+      'fontWeight': style.fontWeight,
+      'fontStyle': style.fontStyle,
+      'height': style.height,
+      'color': style.color,
+      'letterSpacing': style.letterSpacing,
+      'wordSpacing': style.wordSpacing,
+      'decoration': style.decoration,
+      'decorationColor': style.decorationColor,
+      'locale': style.locale,
+    };
+
+void _expectSameParagraph(WidgetTester tester) {
+  final fast = tester.renderObject<RenderParagraph>(_paragraph(_fastKey));
+  final old = tester.renderObject<RenderParagraph>(_paragraph(_oldKey));
+  expect(fast.text.toPlainText(), old.text.toPlainText());
+  expect(
+      _styles(fast.text).map(_styleShape), _styles(old.text).map(_styleShape));
+  expect(fast.size.width, closeTo(old.size.width, .001));
+  expect(fast.size.height, closeTo(old.size.height, .001));
+  expect(fast.textAlign, old.textAlign);
+  expect(fast.textDirection, old.textDirection);
+  expect(fast.textHeightBehavior, old.textHeightBehavior);
+  expect(fast.textScaler, old.textScaler);
+  expect(fast.maxLines, old.maxLines);
+  expect(fast.softWrap, old.softWrap);
+  expect(fast.overflow, old.overflow);
+  expect(
+      find.descendant(
+          of: find.byKey(_fastKey), matching: find.byType(HtmlWidget)),
+      findsNothing);
+  expect(
+      find.descendant(
+          of: find.byKey(_oldKey), matching: find.byType(HtmlWidget)),
+      findsOneWidget);
