+import 'package:c001apk_flutter/utils/markdown_content.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:html/parser.dart' as html;
+
+void main() {
+  test('plain multilingual posts keep their original fallback representation',
+      () {
+    for (final source in [
+      '',
+      '今天的续航不错，手机没有发热。',
+      'iPhone 16 Pro Max 今天拍了照片 📸',
+      '第一行\n第二行\n\n第三行',
+      '   三个空格不构成代码\n下一行',
+      '价格：999 元；电量 80%！',
+      'Café naïve 中文 العربية 한국어 🙂',
+    ]) {
+      for (final coolapk in [false, true]) {
+        for (final showEmoji in [false, true]) {
+          for (final forExport in [false, true]) {
+            final result = MarkdownContent.parse(source,
+                coolapk: coolapk, showEmoji: showEmoji, forExport: forExport);
+            expect(result.isMarkdown, isFalse, reason: source);
+            expect(result.source, source);
+            expect(result.preview, source);
+            expect(result.html, isEmpty);
+            expect(result.imageUrls, isEmpty);
+          }
+        }
+      }
+    }
+  });
+
+  test('explicit plain documents still render through Markdown', () {
+    const source = '更新说明\n下一行';
+    for (final coolapk in [false, true]) {
+      final result =
+          MarkdownContent.parse(source, explicit: true, coolapk: coolapk);
+      expect(result.isMarkdown, isTrue);
+      expect(result.html, contains('<p>'));
+      expect(html.parseFragment(result.html).text, contains('更新说明'));
+    }
+    expect(MarkdownContent.parse(source).isMarkdown, isFalse);
+  });
+
+  test('block and inline detection boundaries retain full Markdown rendering',
+      () {
+    final cases = <String, String>{
+      '# 标题': 'h1',
+      '标题\n===': 'h1',
+      '标题\n---': 'h2',
+      '- 第一项\n- 第二项': 'ul',
+      '+ 第一项\n+ 第二项': 'ul',
+      '* 第一项\n* 第二项': 'ul',
+      '1. 第一项\n2. 第二项': 'ol',
+      '1) 第一项\n2) 第二项': 'ol',
+      '正文\n\n    代码': 'pre',
+      '\t代码': 'pre',
+      '```text\n代码\n```': 'pre',
+      '~~~text\n代码\n~~~': 'pre',
+      '> 引用': 'blockquote',
+      '**重点**': 'strong',
+      '_强调_': 'em',
+      '~~删除~~': 'del',
+      '`代码`': 'code',
+      '[链接](https://example.com)': 'a',
+      '![图片](https://example.com/image.png)': 'img',
+      '| 标题 |\n| --- |\n| 内容 |': 'table',
+    };
+    for (final entry in cases.entries) {
+      final result = MarkdownContent.parse(entry.key);
+      expect(result.isMarkdown, isTrue, reason: entry.key);
+      expect(
+          html.parseFragment(result.html).querySelector(entry.value), isNotNull,
+          reason: entry.key);
+    }
+  });
+
+  test('normalization cannot hide encoded or HTML separated syntax', () {
+    for (final source in [
+      '&#35;&#35; 标题',
+      '&#42;&#42;重点&#42;&#42;',
+      '&gt; 引用',
+      '第一行<br>## 标题',
+      '<p>第一行</p><p>## 标题</p>',
+      '## 标题\r\n正文',
+    ]) {
+      expect(MarkdownContent.parse(source).isMarkdown, isTrue, reason: source);
+    }
+  });
+
+  test('native links, emoji and escaped punctuation retain legacy fallback',
+      () {
+    for (final source in [
+      '<a class="feed-link-tag" href="/t/test">#test#</a> 今天更新',
+      '<a class="feed-link-url" href="coolmarket://feed/123">动态</a>',
+      '[哈哈哈] 今天拍了照片',
+      r'\*普通文本\*',
+      '1. 单项',
+      '#话题# 普通内容',
+      'https://example.com?a=1&b=2',
+      'POCO_X3_GT',
+    ]) {
+      final result = MarkdownContent.parse(source);
+      expect(result.isMarkdown, isFalse, reason: source);
+      expect(result.preview, source);
+      expect(result.source, source);
+    }
+  });
+}
