+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:c001apk_flutter/components/update_check_tile.dart';
+import 'package:c001apk_flutter/constants/lite_edition.dart';
+import 'package:c001apk_flutter/logic/announcements/announcement_service.dart';
+import 'package:c001apk_flutter/logic/app_update/update_preferences.dart';
+import 'package:c001apk_flutter/logic/app_update/update_service.dart';
+import 'package:c001apk_flutter/pages/settings/settings_page.dart';
+import 'package:c001apk_flutter/utils/storage_util.dart';
+import 'package:dio/dio.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:hive/hive.dart';
+
+import '../announcements/fixtures.dart';
+import '../update/app_update_test.dart' show ReleaseAdapter;
+
+void main() {
+  late Directory directory;
+
+  setUpAll(() async {
+    directory = await Directory.systemTemp.createTemp('c001apk-lite-test-');
+    Hive.init(directory.path);
+    GStorage.settings = await Hive.openBox('settings');
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(
+            const MethodChannel('plugins.flutter.io/path_provider'),
+            (_) async => directory.path);
+  });
+  setUp(() async {
+    Get.testMode = true;
+    await GStorage.settings.clear();
+  });
+  tearDown(() => Get.reset());
+  tearDownAll(() async {
+    await Hive.close();
+    await directory.delete(recursive: true);
+  });
+
+  test('stored enabled setting cannot restore automatic updates in lite',
+      () async {
+    await GStorage.settings.put(UpdatePreferences.enabledKey, true);
+    final adapter = ReleaseAdapter();
+    UpdateService restartedService() => UpdateService(
+        preferences: UpdatePreferences(GStorage.settings),
+        dio: Dio()..httpClientAdapter = adapter,
+        currentVersion: () async => '1.1.5');
+
+    final expectedAutomatic = LiteEdition.enabled
+        ? UpdateStatus.suppressed
+        : UpdateStatus.available;
+    final first = restartedService();
+    expect((await first.check(automatic: true)).status, expectedAutomatic);
+    expect((await first.check()).status, UpdateStatus.available,
+        reason: 'A deliberate manual check must remain available.');
+    final restarted = restartedService();
+    expect((await restarted.check(automatic: true)).status, expectedAutomatic);
+    expect(adapter.requests, hasLength(LiteEdition.enabled ? 1 : 3));
+  });
+
+  test('quiet announcement default still permits reading important notices',
+      () async {
+    final box = await Hive.openBox<dynamic>(
+        'lite-announcements', bytes: Uint8List(0));
+    final adapter = AnnouncementAdapter()
+      ..index = indexJson(1, [noticeJson('important', important: true)]);
+    final service = AnnouncementService(box,
+        dio: Dio()..httpClientAdapter = adapter,
+        clock: () => DateTime.utc(2026, 11, 15));
+    addTearDown(() async {
+      service.dispose();
+      await box.close();
+    });
+
+    expect(service.automaticEnabled, !LiteEdition.enabled);
+    await service.sync(SyncReason.coldStart);
+    expect(adapter.requests, hasLength(LiteEdition.enabled ? 0 : 1));
+    await service.sync(SyncReason.manual);
+    final important = service.items.single;
+    expect(important.important, true);
+    expect(await service.loadBody(important), sampleBody);
+    expect(service.isRead(important), false,
+        reason: 'Quiet startup must not consume unread or prompt receipts.');
+    expect(service.pendingImportant?.id, 'important');
+
+    // Users may explicitly opt back into project notices; these are separate
+    // from the permanently disabled automatic version-update prompts.
+    await service.setAutomaticEnabled(true);
+    expect(service.automaticEnabled, true);
+  });
+
+  testWidgets('settings retain manual update and hide the lite auto switch',
+      (tester) async {
+    await tester.pumpWidget(const GetMaterialApp(
+        home: SettingsDetailPage(section: SettingsSection.storage)));
+    await tester.pumpAndSettle();
+    expect(find.text('自动检查 c001apk 更新'),
+        LiteEdition.enabled ? findsNothing : findsOneWidget);
+    expect(find.text('检查更新'), findsOneWidget);
+    if (LiteEdition.enabled) {
+      expect(find.text('查看原版更新；精简版需单独更新'), findsOneWidget);
+    }
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('automatic UI request neither fetches nor opens a lite dialog',
+      (tester) async {
+    final adapter = ReleaseAdapter();
+    final service = UpdateService(
+        preferences: UpdatePreferences(GStorage.settings),
+        dio: Dio()..httpClientAdapter = adapter,
+        currentVersion: () async => '1.1.5');
+    late BuildContext context;
+    await tester.pumpWidget(GetMaterialApp(home: Builder(builder: (value) {
+      context = value;
+      return const Scaffold(body: Text('首页'));
+    })));
+    await AppUpdates.check(context,
+        automatic: true, updateService: service);
+    await tester.pumpAndSettle();
+    expect(adapter.requests, isEmpty);
+    expect(find.text('发现新版本'), findsNothing);
+    expect(AppUpdates.isActive, false);
+    expect(find.text('首页'), findsOneWidget);
+    await tester.pumpWidget(const SizedBox.shrink());
+  }, skip: !LiteEdition.enabled);
+}
diff --git a/apps/flutter/test/lite/navigation_layout_test.dart b/apps/flutter/test/lite/navigation_layout_test.dart
new file mode 100644
index 0000000..c802c7c
--- /dev/null
+++ b/apps/flutter/test/lite/navigation_layout_test.dart
@@ -0,0 +1,155 @@
+import 'dart:io';
+import 'dart:ui' as ui;
+
+import 'package:c001apk_flutter/components/basic_glass.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/rendering.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _exportPreviews = bool.fromEnvironment('EXPORT_UI_PREVIEWS');
+const _previewKey = ValueKey('navigation-preview');
+const _phoneSize = Size(400, 850);
+
+Future<void> _mount(
+  WidgetTester tester, {
+  Brightness brightness = Brightness.dark,
+  double bottom = 34,
+  double scale = 1,
+  ValueChanged<int>? onSelected,
+}) async {
+  await tester.binding.setSurfaceSize(_phoneSize);
+  addTearDown(() => tester.binding.setSurfaceSize(null));
+  var selected = 2;
+  final theme = ThemeData(
+    platform: TargetPlatform.iOS,
+    fontFamily: _exportPreviews ? 'PreviewSans' : null,
+    colorScheme: ColorScheme.fromSeed(
+        seedColor: Colors.deepPurple, brightness: brightness),
+  );
+  await tester.pumpWidget(MaterialApp(
+    theme: theme,
+    home: RepaintBoundary(
+      key: _previewKey,
+      child: MediaQuery(
+        data: MediaQueryData(
+          size: _phoneSize,
+          padding: EdgeInsets.only(top: 59, bottom: bottom),
+          viewPadding: EdgeInsets.only(top: 59, bottom: bottom),
+          textScaler: TextScaler.linear(scale),
+        ),
+        child: StatefulBuilder(builder: (context, setState) {
+          return Scaffold(
+            body: const SafeArea(
+              bottom: false,
+              child: Padding(
+                padding: EdgeInsets.all(24),
+                child: Text('底部导航布局预览'),
+              ),
+            ),
+            bottomNavigationBar: LiquidNavigationBar(
+              selectedIndex: selected,
+              onDestinationSelected: (index) {
+                setState(() => selected = index);
+                onSelected?.call(index);
+              },
+            ),
+          );
+        }),
+      ),
+    ),
+  ));
+  await tester.pumpAndSettle();
+}
+
+Future<void> _export(WidgetTester tester, String name) async {
+  if (!_exportPreviews) return;
+  final boundary = tester.renderObject<RenderRepaintBoundary>(
+      find.byKey(_previewKey));
+  await tester.runAsync(() async {
+    final image = await boundary.toImage(pixelRatio: 2);
+    try {
+      final bytes = await image.toByteData(format: ui.ImageByteFormat.png);
+      if (bytes == null) throw StateError('Navigation preview returned no PNG');
+      final directory = Directory('build/ui-previews');
+      await directory.create(recursive: true);
+      await File('${directory.path}/$name.png').writeAsBytes(
+          bytes.buffer.asUint8List(bytes.offsetInBytes, bytes.lengthInBytes));
+    } finally {
+      image.dispose();
+    }
+  });
+}
+
+void main() {
+  setUpAll(() async {
+    if (!_exportPreviews) return;
+    final font = Platform.environment['UI_PREVIEW_FONT'];
+    if (font == null || !await File(font).exists()) {
+      throw StateError('EXPORT_UI_PREVIEWS requires UI_PREVIEW_FONT');
+    }
+    final labels = FontLoader('PreviewSans')
+      ..addFont(Future.value(ByteData.sublistView(await File(font).readAsBytes())));
+    final icons = FontLoader('MaterialIcons')
+      ..addFont(rootBundle.load('fonts/MaterialIcons-Regular.otf'));
+    await Future.wait([labels.load(), icons.load()]);
+  });
+
+  for (final brightness in Brightness.values) {
+    for (final scale in [1.0, 1.6]) {
+      testWidgets(
+          'capsule content and selected background are centered: '
+          '${brightness.name}, text $scale, iPhone inset 34', (tester) async {
+        await _mount(tester, brightness: brightness, scale: scale);
+        final surface = tester.getRect(
+            find.byKey(const ValueKey('liquid-drag-surface')));
+        final buttons = find.byType(TextButton);
+        expect(buttons, findsNWidgets(3));
+        final theme = Theme.of(tester.element(buttons.first));
+        final widths = <double>[];
+        for (var index = 0; index < 3; index++) {
+          final button = buttons.at(index);
+          final buttonRect = tester.getRect(button);
+          final ink = find.descendant(of: button, matching: find.byType(Material));
+          expect(ink, findsOneWidget);
+          final inkRect = tester.getRect(ink);
+          final icon = tester.getRect(
+              find.descendant(of: button, matching: find.byType(Icon)));
+          final label = tester.getRect(
+              find.descendant(of: button, matching: find.byType(Text)));
+          expect(buttonRect.center.dy, closeTo(surface.center.dy, .1));
+          expect(inkRect.center.dy, closeTo(surface.center.dy, .1),
+              reason: 'The visible selection pill must have equal top/bottom space');
+          expect(icon.expandToInclude(label).center.dy,
+              closeTo(surface.center.dy, .1));
+          expect(tester.widget<Material>(ink).color,
+              index == 2 ? theme.colorScheme.primaryContainer : Colors.transparent);
+          widths.add(buttonRect.width);
+        }
+        expect(widths[0], closeTo(widths[1], .1));
+        expect(widths[1], closeTo(widths[2], .1));
+        expect(_phoneSize.height - surface.bottom, closeTo(34, .1),
+            reason: 'The iPhone home-indicator inset belongs outside the capsule');
+        expect(tester.takeException(), isNull);
+        await _export(tester, 'navigation-${brightness.name}-scale-$scale');
+      });
+    }
+  }
+
+  testWidgets('no bottom inset also centers the capsule and all taps still work',
+      (tester) async {
+    var selected = 2;
+    await _mount(tester, bottom: 0, onSelected: (value) => selected = value);
+    final surface = tester.getRect(
+        find.byKey(const ValueKey('liquid-drag-surface')));
+    expect(_phoneSize.height - surface.bottom, closeTo(12, .1));
+    for (var index = 0; index < 3; index++) {
+      final button = find.byType(TextButton).at(index);
+      expect(tester.getCenter(button).dy, closeTo(surface.center.dy, .1));
+      await tester.tap(button);
+      await tester.pumpAndSettle();
+      expect(selected, index);
+    }
+    expect(tester.takeException(), isNull);
+  });
+}
