@@ -0,0 +1,33 @@
+import 'package:flutter/widgets.dart';
+
+import 'performance_recorder.dart';
+
+/// Only fixed page categories are recorded; never route parameters or IDs.
+class PerformanceNavigationObserver extends NavigatorObserver {
+  PerformanceNavigationObserver({PerformanceRecorder? recorder})
+      : _recorder = recorder ?? PerformanceRecorder.instance;
+
+  final PerformanceRecorder _recorder;
+
+  static int screenCode(String? name) {
+    final path = Uri.tryParse(name ?? '')?.path ?? '';
+    if (path == '/') return 1;
+    if (path.startsWith('/feed/')) return 2;
+    if (path == '/imageview') return 3;
+    if (path == '/search' || path == '/searchResult') return 4;
+    if (path.startsWith('/u/')) return 5;
+    if (path == '/settings' || path == '/performance') return 6;
+    return 0;
+  }
+
+  void _record(Route<dynamic>? route) {
+    if (route == null) return;
+    _recorder.begin(PerformanceOperation.navigation,
+        metrics: {'screen': screenCode(route.settings.name)})?.finish();
+  }
+
+  @override
+  void didChangeTop(
+          Route<dynamic> topRoute, Route<dynamic>? previousTopRoute) =>
+      _record(topRoute);
+}
diff --git a/apps/flutter/lib/logic/performance/performance_recorder.dart b/apps/flutter/lib/logic/performance/performance_recorder.dart
new file mode 100644
index 0000000..3f5ee05
--- /dev/null
+++ b/apps/flutter/lib/logic/performance/performance_recorder.dart
@@ -0,0 +1,333 @@
+import 'dart:async';
+import 'dart:collection';
+import 'dart:convert';
+import 'dart:developer' as developer;
+import 'dart:math' as math;
+import 'dart:ui' show FramePhase, FrameTiming;
+
+import 'package:flutter/foundation.dart';
+import 'package:flutter/scheduler.dart';
+
+enum PerformanceOperation {
+  pageFetch,
+  pagePublish,
+  pageFilter,
+  imageLoad,
+  navigation,
+}
+
+typedef PerformanceFrameCallback = void Function(List<FrameTiming>);
+
+/// Opt-in, bounded, in-memory diagnostics. Nothing is uploaded or persisted.
+///
+/// Frame durations indicate expensive work, not the display's actual FPS.
+/// Timeline.now and engine FrameTiming use the monotonic timeline clock, so
+/// delayed/batched timing reports retain their original position relative to
+/// pagination and image events. Wall-clock time is deliberately not recorded.
+class PerformanceRecorder extends ChangeNotifier {
+  PerformanceRecorder._()
+      : _clock = (() => developer.Timeline.now),
+        _addFrameCallback = ((callback) =>
+            SchedulerBinding.instance.addTimingsCallback(callback)),
+        _removeFrameCallback = ((callback) =>
+            SchedulerBinding.instance.removeTimingsCallback(callback)),
+        _timerFactory = Timer.new,
+        maxEvents = 400,
+        maxFrames = 1200,
+        maxSlowFrames = 400,
+        recordingLimit = const Duration(minutes: 5);
+
+  @visibleForTesting
+  PerformanceRecorder.forTesting({
+    required int Function() clock,
+    required void Function(PerformanceFrameCallback) addFrameCallback,
+    required void Function(PerformanceFrameCallback) removeFrameCallback,
+    Timer Function(Duration, void Function())? timerFactory,
+    this.maxEvents = 400,
+    this.maxFrames = 1200,
+    this.maxSlowFrames = 400,
+    this.recordingLimit = const Duration(minutes: 5),
+  })  : assert(maxEvents > 0),
+        assert(maxFrames > 0),
+        assert(maxSlowFrames > 0),
+        assert(recordingLimit > Duration.zero),
+        _clock = clock,
+        _addFrameCallback = addFrameCallback,
+        _removeFrameCallback = removeFrameCallback,
+        _timerFactory = timerFactory ?? Timer.new;
+
+  static final PerformanceRecorder instance = PerformanceRecorder._();
+
+  final int maxEvents;
+  final int maxFrames;
+  final int maxSlowFrames;
+  final Duration recordingLimit;
+  final int Function() _clock;
+  final void Function(PerformanceFrameCallback) _addFrameCallback;
+  final void Function(PerformanceFrameCallback) _removeFrameCallback;
+  final Timer Function(Duration, void Function()) _timerFactory;
+  final _events = ListQueue<_OperationSample>();
+  final _frames = ListQueue<_FrameSample>();
+  final _slowFrames = ListQueue<_FrameSample>();
+  final _operationTotals = <PerformanceOperation, _OperationTotals>{};
+  Timer? _timer;
+  bool _recording = false;
+  bool _disposed = false;
+  int _generation = 0;
+  int _startUs = 0;
+  int _endUs = 0;
+  int _eventCount = 0;
+  int _frameCount = 0;
+  int _over8333 = 0;
+  int _over16667 = 0;
+  int _maxBuildUs = 0;
+  int _maxRasterUs = 0;
+
+  bool get isRecording => _recording;
+
+  /// A new session replaces the previous report. Repeated start is a no-op.
+  void start() {
+    if (_disposed || _recording) return;
+    _reset();
+    _generation++;
+    _startUs = _clock();
+    _endUs = _startUs;
+    _recording = true;
+    _addFrameCallback(_receiveFrames);
+    _timer = _timerFactory(recordingLimit, stop);
+    notifyListeners();
+  }
+
+  void stop() {
+    if (!_recording) return;
+    _endUs = _clock();
+    _recording = false;
+    _generation++;
+    _timer?.cancel();
+    _timer = null;
+    _removeFrameCallback(_receiveFrames);
+    notifyListeners();
+  }
+
+  /// Clears the report and stops collection, invalidating pending image loads.
+  void clear() {
+    if (_disposed) return;
+    if (_recording) {
+      _recording = false;
+      _timer?.cancel();
