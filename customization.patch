diff --git a/apps/flutter/lib/router/ios_page_transition.dart b/apps/flutter/lib/router/ios_page_transition.dart
new file mode 100644
index 0000000..7fdd63d
--- /dev/null
+++ b/apps/flutter/lib/router/ios_page_transition.dart
@@ -0,0 +1,296 @@
+import 'package:flutter/cupertino.dart';
+import 'package:flutter/gestures.dart';
+
+/// Cupertino visuals with a content-area back drag. Child horizontal gestures
+/// join the arena first, so a gallery, slider or horizontal list keeps its drag.
+/// The leading edge remains available on image and embedded browser routes.
+class AppCupertinoPageTransitionsBuilder extends PageTransitionsBuilder {
+  const AppCupertinoPageTransitionsBuilder();
+
+  @override
+  Duration get transitionDuration => const Duration(milliseconds: 500);
+
+  @override
+  Widget buildTransitions<T>(
+      PageRoute<T> route,
+      BuildContext context,
+      Animation<double> animation,
+      Animation<double> secondaryAnimation,
+      Widget child) {
+    if (route.fullscreenDialog) {
+      if (MediaQuery.disableAnimationsOf(context)) return child;
+      return CupertinoFullscreenDialogTransition(
+          primaryRouteAnimation: animation,
+          secondaryRouteAnimation: secondaryAnimation,
+          linearTransition: route.popGestureInProgress,
+          child: child);
+    }
+    return _IOSBackTransition(route: route, child: child);
+  }
+}
+
+class _IOSBackTransition extends StatefulWidget {
+  const _IOSBackTransition({required this.route, required this.child});
+  final PageRoute route;
+  final Widget child;
+
+  @override
+  State<_IOSBackTransition> createState() => _IOSBackTransitionState();
+}
+
+class _ContentBackDragRecognizer extends HorizontalDragGestureRecognizer {
+  _ContentBackDragRecognizer({super.debugOwner}) {
+    // A lone recognizer can win the arena on pointer down. Wait for movement
+    // so the route can distinguish a back drag from a tap or leftward drag.
+    onlyAcceptDragOnThreshold = true;
+  }
+
+  void rejectPending() => resolve(GestureDisposition.rejected);
+}
+
+class _IOSBackTransitionState extends State<_IOSBackTransition> {
+  static final _imageScale = Tween<double>(begin: 0.86, end: 1)
+      .chain(CurveTween(curve: Curves.easeOutCubic));
+  static final _imageOpacity = CurveTween(curve: Curves.easeOut);
+  late final _ContentBackDragRecognizer _recognizer =
+      _ContentBackDragRecognizer(debugOwner: this)
+        ..onStart = _start
+        ..onUpdate = _update
+        ..onEnd = _end
+        ..onCancel = _cancel;
+  int? _pointer;
+  final _pointers = <int>{};
+  Offset? _down;
+  bool _edgePointer = false;
+  bool _tracking = false;
+  NavigatorState? _gestureNavigator;
+  AnimationController? _gestureController;
+  AnimationStatusListener? _settled;
+  final _pageKey = GlobalKey();
+
+  bool get _isImageRoute =>
+      Uri.tryParse(widget.route.settings.name ?? '')?.path == '/imageview';
+
+  bool get _rtl => Directionality.of(context) == TextDirection.rtl;
+  double _logical(double value) => _rtl ? -value : value;
+  double get _width => context.size!.width;
+  double get _edgeWidth {
+    final padding = MediaQuery.paddingOf(context);
+    final inset = _rtl ? padding.right : padding.left;
+    return inset > 24 ? inset : 24;
+  }
+
+  bool get _canStart {
+    final route = widget.route;
+    // Keep eligibility separate from GetX's legacy detector configuration.
+    // GetX exposes Flutter's legacy callback check through this public getter.
+    // Its separate popGesture option only controls the old detector wrapper.
+    final legacyGestureAllowed = route.popGestureEnabled;
+    return route.isCurrent &&
+        route.isActive &&
+        !route.isFirst &&
+        !route.fullscreenDialog &&
+        !route.willHandlePopInternally &&
+        legacyGestureAllowed &&
+        route.popDisposition == RoutePopDisposition.pop &&
+        route.animation?.status == AnimationStatus.completed &&
+        route.secondaryAnimation?.status == AnimationStatus.dismissed &&
+        !(route.navigator?.userGestureInProgress ?? true);
+  }
+
+  bool get _contentEnabled {
+    final path = Uri.tryParse(widget.route.settings.name ?? '')?.path;
+    if (const {'/imageview', '/webview', '/login', '/chat'}.contains(path)) {
+      return false;
+    }
+    final focus = FocusManager.instance.primaryFocus?.context;
+    return focus?.widget is! EditableText &&
+        focus?.findAncestorWidgetOfExactType<EditableText>() == null;
+  }
+
+  void _downEvent(PointerDownEvent event, {required bool edge}) {
+    if (event.kind != PointerDeviceKind.touch) return;
+    _pointers.add(event.pointer);
+    if (_pointers.length > 1) {
+      // Reject pending recognition as well as an active back gesture. A pinch
+      // can begin before the first finger crosses the horizontal drag slop.
+      _recognizer.rejectPending();
+      _cancel();
+      return;
+    }
+    if (!_canStart) return;
+    final local = (context.findRenderObject()! as RenderBox)
+        .globalToLocal(event.position);
+    final fromEdge = (_rtl ? _width - local.dx : local.dx) <= _edgeWidth;
+    // Both listeners see an edge pointer; register it exactly once.
+    if (edge != fromEdge || (!edge && !_contentEnabled)) return;
+    if (_pointer != null) return;
+    _pointer = event.pointer;
+    _down = event.position;
+    _edgePointer = edge;
+    _recognizer.addPointer(event);
+  }
+
+  void _start(DragStartDetails details) {
+    if (!_canStart ||
+        (!_edgePointer && !_contentEnabled) ||
+        _down == null ||
+        _logical(details.globalPosition.dx - _down!.dx) <= 0) {
+      return;
+    }
+    // Flutter exposes the route controller to its own Cupertino gesture
+    // implementation. Keep this access confined to the transition boundary.
+    // ignore: invalid_use_of_protected_member
+    final controller = widget.route.controller;
+    if (controller == null) return;
+    _gestureController = controller;
+    _gestureNavigator = widget.route.navigator!;
+    _tracking = true;
+    _gestureNavigator!.didStartUserGesture();
+    setState(() {});
+  }
+
+  void _update(DragUpdateDetails details) {
+    if (!_tracking) return;
+    if (!widget.route.isCurrent ||
+        widget.route.popDisposition != RoutePopDisposition.pop) {
+      _finish(commit: false);
+      return;
+    }
+    final controller = _gestureController!;
+    controller.value -= _logical(details.primaryDelta!) / _width;
+  }
+
+  void _end(DragEndDetails details) {
+    if (_tracking) {
+      final velocity = _logical(details.velocity.pixelsPerSecond.dx) / _width;
+      final commit =
+          velocity.abs() >= 1 ? velocity > 0 : _gestureController!.value < 0.5;
+      _finish(commit: commit);
+    }
+    _pointer = null;
+    _down = null;
+  }
+
+  void _cancel() {
+    if (_tracking) _finish(commit: false);
+    _pointer = null;
+    _down = null;
+  }
+
+  void _finish({required bool commit}) {
+    if (!_tracking) return;
+    _tracking = false;
+    final route = widget.route;
+    final controller = _gestureController!;
+    final canCommit = commit &&
+        route.isCurrent &&
+        route.isActive &&
+        !route.isFirst &&
+        !route.fullscreenDialog &&
+        route.popDisposition == RoutePopDisposition.pop &&
+        !route.willHandlePopInternally;
+    if (canCommit) {
+      _gestureNavigator!.pop();
+      // Continue from the dragged position; restarting at 1 would jump back.
+      if (controller.isAnimating) {
+        controller.animateBack(0,
+            duration: const Duration(milliseconds: 350),
+            curve: Curves.fastEaseInToSlowEaseOut);
+      }
+    } else if (route.isActive) {
+      controller.animateTo(1,
+          duration: const Duration(milliseconds: 350),
+          curve: Curves.fastEaseInToSlowEaseOut);
+    }
+    if (controller.isAnimating) {
+      _settled = (status) {
+        if (status == AnimationStatus.completed ||
+            status == AnimationStatus.dismissed) _stopGesture();
+      };
+      controller.addStatusListener(_settled!);
+    } else {
+      _stopGesture();
+    }
+  }
+
+  void _stopGesture() {
+    if (_settled != null) _gestureController?.removeStatusListener(_settled!);
+    _settled = null;
+    _gestureController = null;
+    final navigator = _gestureNavigator;
+    _gestureNavigator = null;
+    if (navigator?.mounted ?? false) navigator!.didStopUserGesture();
+    if (mounted) setState(() {});
+  }
+
+  @override
+  void dispose() {
+    _recognizer.dispose();
+    if (_settled != null) _gestureController?.removeStatusListener(_settled!);
+    final navigator = _gestureNavigator;
+    if (navigator != null) {
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        if (navigator.mounted) navigator.didStopUserGesture();
+      });
+    }
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final reducedMotion = MediaQuery.disableAnimationsOf(context);
+    final content = KeyedSubtree(key: _pageKey, child: widget.child);
+    final Widget page;
+    if (reducedMotion) {
+      page = content;
+    } else if (_isImageRoute && _gestureNavigator == null) {
+      // Ordinary gallery opening/closing is a centered expansion. Keep the
+      // existing horizontal, finger-following transition for an edge return,
+      // including its cancel/commit animation until the navigator settles.
+      // The image provider and PhotoView scale are untouched by this transform.
+      page = FadeTransition(
+        opacity: widget.route.animation!.drive(_imageOpacity),
+        child: ScaleTransition(
+          alignment: Alignment.center,
+          scale: widget.route.animation!.drive(_imageScale),
+          child: content,
+        ),
+      );
+    } else {
+      page = CupertinoPageTransition(
+          primaryRouteAnimation: widget.route.animation!,
+          secondaryRouteAnimation: widget.route.secondaryAnimation!,
+          linearTransition: widget.route.popGestureInProgress,
+          child: content);
+    }
+    return Listener(
+      // Observe a second finger even over the previous page exposed by a drag.
+      // The translated child no longer hit-tests that part of this route.
+      behavior: HitTestBehavior.translucent,
+      onPointerDown: (event) => _downEvent(event, edge: false),
+      onPointerUp: (event) {
+        _pointers.remove(event.pointer);
+        if (_pointer == event.pointer) {
+          _pointer = null;
+          _down = null;
+        }
+      },
+      onPointerCancel: (event) {
+        _pointers.remove(event.pointer);
+        _cancel();
+      },
+      child: Stack(fit: StackFit.passthrough, children: [
+        page,
+        PositionedDirectional(
+            start: 0,
+            top: 0,
+            bottom: 0,
+            width: _edgeWidth,
+            child: Listener(
+                behavior: HitTestBehavior.translucent,
+                onPointerDown: (event) => _downEvent(event, edge: true))),
+      ]),
+    );
+  }
+}
