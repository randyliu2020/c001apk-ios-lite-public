+import 'dart:async';
+import 'dart:convert';
+
+import 'package:c001apk_flutter/logic/performance/performance_navigation.dart';
+import 'package:c001apk_flutter/logic/performance/performance_recorder.dart';
+import 'package:c001apk_flutter/pages/settings/performance_page.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+// The plugin interface is used only to replace the OS share sheet in tests.
+// ignore: depend_on_referenced_packages
+import 'package:share_plus_platform_interface/share_plus_platform_interface.dart';
+
+class _IdleTimer implements Timer {
+  bool _active = true;
+  @override
+  void cancel() => _active = false;
+  @override
+  bool get isActive => _active;
+  @override
+  int get tick => 0;
+}
+
+class _TestShare extends SharePlatform {
+  int calls = 0;
+  List<XFile> files = [];
+  List<String>? names;
+  Rect? origin;
+
+  @override
+  Future<ShareResult> shareXFiles(List<XFile> files,
+      {String? subject,
+      String? text,
+      Rect? sharePositionOrigin,
+      List<String>? fileNameOverrides}) async {
+    calls++;
+    this.files = files;
+    names = fileNameOverrides;
+    origin = sharePositionOrigin;
+    return const ShareResult('', ShareResultStatus.dismissed);
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late PerformanceRecorder recorder;
+  late SharePlatform previousShare;
+  late _TestShare shares;
+  String? clipboard;
+  int added = 0;
+  int removed = 0;
+  int time = 1000000;
+
+  setUp(() {
+    added = removed = 0;
+    time = 1000000;
+    clipboard = null;
+    recorder = PerformanceRecorder.forTesting(
+      clock: () => time++,
+      addFrameCallback: (_) => added++,
+      removeFrameCallback: (_) => removed++,
+      timerFactory: (_, __) => _IdleTimer(),
+    );
+    previousShare = SharePlatform.instance;
+    SharePlatform.instance = shares = _TestShare();
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(SystemChannels.platform, (call) async {
+      if (call.method == 'Clipboard.setData') {
+        clipboard = call.arguments['text'] as String;
+      }
+      return null;
+    });
+  });
+
+  tearDown(() {
+    recorder.dispose();
+    SharePlatform.instance = previousShare;
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(SystemChannels.platform, null);
+  });
+
+  Future<void> finish(WidgetTester tester) async {
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pumpAndSettle();
+    expect(tester.takeException(), isNull);
+  }
+
+  Future<void> tapText(WidgetTester tester, String text) async {
+    await tester.ensureVisible(find.text(text));
+    await tester.tap(find.text(text));
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('recording is opt-in and on/off/clear never exports',
+      (tester) async {
+    await tester
+        .pumpWidget(MaterialApp(home: PerformancePage(recorder: recorder)));
+    expect(recorder.isRecording, isFalse);
+    expect(added, 0);
+    expect(shares.calls, 0);
+    expect(clipboard, isNull);
+
+    await tester.tap(find.byType(SwitchListTile));
+    await tester.pump();
+    expect(recorder.isRecording, isTrue);
+    expect(added, 1);
+    recorder.begin(PerformanceOperation.pagePublish,
+        metrics: {'incoming': 20})!.finish();
+    await tapText(tester, '刷新统计');
+    expect(find.textContaining('1 次列表更新'), findsOneWidget);
+    await tester.ensureVisible(find.byType(SwitchListTile));
+    await tester.tap(find.byType(SwitchListTile));
+    await tester.pump();
+    expect(recorder.isRecording, isFalse);
+    expect(removed, 1);
+    expect(recorder.snapshot()['eventCount'], 1);
+
+    await tester.tap(find.byType(SwitchListTile));
+    await tester.pump();
+    expect(recorder.snapshot()['eventCount'], 0,
+        reason: 'A new opt-in session replaces the old report.');
+    recorder.begin(PerformanceOperation.imageLoad)!.finish();
+    await tapText(tester, '清空记录');
+    expect(recorder.isRecording, isFalse);
+    expect(recorder.snapshot()['eventCount'], 0);
+    expect(shares.calls, 0);
+    expect(clipboard, isNull);
+    await finish(tester);
+  });
+
+  testWidgets('leaving the recording page keeps collection active; copy stops',
+      (tester) async {
+    final navigator = GlobalKey<NavigatorState>();
+    final observer = PerformanceNavigationObserver(recorder: recorder);
+    await tester.pumpWidget(MaterialApp(
+      navigatorKey: navigator,
+      navigatorObservers: [observer],
+      home: const Scaffold(body: Text('首页')),
+    ));
+    void open() => navigator.currentState!.push(MaterialPageRoute<void>(
+        settings: const RouteSettings(name: '/performance'),
+        builder: (_) => PerformancePage(recorder: recorder)));
+    open();
+    await tester.pumpAndSettle();
+    await tester.tap(find.byType(SwitchListTile));
+    await tester.pump();
+    navigator.currentState!.pop();
+    await tester.pumpAndSettle();
+    expect(recorder.isRecording, isTrue);
+    expect(removed, 0);
+    recorder
+        .begin(PerformanceOperation.pageFetch, metrics: {'page': 2})!.finish();
+    open();
+    await tester.pumpAndSettle();
+    await tapText(tester, '停止并复制');
+    expect(recorder.isRecording, isFalse);
+    expect(removed, 1);
+    expect(shares.calls, 0);
+    final payload = jsonDecode(clipboard!) as Map;
+    expect(payload['recording'], isFalse);
+    expect(payload['eventCount'], greaterThanOrEqualTo(1));
+    expect((payload['operations'] as Map)['pageFetch']['count'], 1);
+    expect(find.text('性能记录已复制'), findsOneWidget);
+    await finish(tester);
+  });
+
+  testWidgets('export opens the share sheet only after the explicit tap',
+      (tester) async {
+    recorder.start();
+    recorder.begin(PerformanceOperation.imageLoad,
+        metrics: {'width': 1200, 'height': 900})!.finish();
+    await tester
+        .pumpWidget(MaterialApp(home: PerformancePage(recorder: recorder)));
+    expect(shares.calls, 0);
+    expect(clipboard, isNull);
+    await tapText(tester, '停止并导出');
+    expect(recorder.isRecording, isFalse);
+    expect(shares.calls, 1);
+    expect(shares.names, ['c001apk-performance.json']);
+    expect(shares.origin!.width, greaterThan(0));
+    expect(shares.origin!.height, greaterThan(0));
+    final payload = jsonDecode(await shares.files.single.readAsString()) as Map;
+    expect(payload['eventCount'], 1);
+    expect(payload['recording'], isFalse);
+    expect(clipboard, isNull);
+    await finish(tester);
+  });
+
+  testWidgets('navigation records only numeric categories of the actual top',
+      (tester) async {
+    final navigator = GlobalKey<NavigatorState>();
+    final observer = PerformanceNavigationObserver(recorder: recorder);
+    recorder.start();
+    await tester.pumpWidget(MaterialApp(
+      navigatorKey: navigator,
+      navigatorObservers: [observer],
+      home: const Scaffold(body: Text('首页')),
+    ));
+    MaterialPageRoute<void> route(String name) => MaterialPageRoute<void>(
+        settings: RouteSettings(name: name), builder: (_) => const Scaffold());
+    List<num> screens() => [
+          for (final event in recorder.snapshot()['events'] as List)
+            if (event['operation'] == 'navigation')
+              event['metrics']['screen'] as num,
+        ];
+    final post = route('/feed/987654321?token=do-not-record');
+    final image = route('/imageview?url=https%3A%2F%2Fprivate.example%2Fa.jpg');
+    navigator.currentState!.push(post);
+    await tester.pumpAndSettle();
+    navigator.currentState!.push(image);
+    await tester.pumpAndSettle();
+    expect(screens(), [1, 2, 3]);
+
+    final background = route('/u/11223344');
+    navigator.currentState!.replace(oldRoute: post, newRoute: background);
+    await tester.pumpAndSettle();
+    expect(screens(), [1, 2, 3],
+        reason: 'Replacing a covered route must not change the screen label.');
+    navigator.currentState!.pop();
+    await tester.pumpAndSettle();
+    expect(screens(), [1, 2, 3, 5]);
+    navigator.currentState!.removeRoute(background);
+    await tester.pumpAndSettle();
+    expect(screens(), [1, 2, 3, 5, 1]);
+
+    final report = recorder.exportJson();
+    for (final secret in [
+      '987654321',
+      'do-not-record',
+      'private.example',
+      '11223344',
+      '/feed/',
+      'https',
+    ]) {
+      expect(report, isNot(contains(secret)));
+    }
+    await finish(tester);
+  });
+}
diff --git a/apps/flutter/test/lite/performance_recorder_test.dart b/apps/flutter/test/lite/performance_recorder_test.dart
new file mode 100644
index 0000000..46c2897
--- /dev/null
+++ b/apps/flutter/test/lite/performance_recorder_test.dart
@@ -0,0 +1,274 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:ui';
+
+import 'package:c001apk_flutter/logic/performance/performance_recorder.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _TestTimer implements Timer {
+  _TestTimer(this.callback);
+  final void Function() callback;
+  bool _active = true;
+  int _tick = 0;
+
+  void fire() {
+    if (!_active) return;
+    _active = false;
+    _tick++;
+    callback();
+  }
+
+  @override
+  void cancel() => _active = false;
+  @override
+  bool get isActive => _active;
+  @override
+  int get tick => _tick;
+}
+
+class _Harness {
+  _Harness(
+      {int maxEvents = 400, int maxFrames = 1200, int maxSlowFrames = 400}) {
+    recorder = PerformanceRecorder.forTesting(
+      clock: () {
+        clockReads++;
+        return now;
+      },
+      addFrameCallback: (value) {
+        adds++;
+        callback = value;
+      },
+      removeFrameCallback: (value) {
+        expect(value, callback);
+        removes++;
+      },
+      timerFactory: (duration, callback) {
+        limit = duration;
+        return timer = _TestTimer(callback);
+      },
+      maxEvents: maxEvents,
+      maxFrames: maxFrames,
+      maxSlowFrames: maxSlowFrames,
+    );
+  }
+
+  late PerformanceRecorder recorder;
+  int now = 1000000;
+  int clockReads = 0;
+  int adds = 0;
+  int removes = 0;
+  void Function(List<FrameTiming>)? callback;
+  _TestTimer? timer;
+  Duration? limit;
+
+  void frames(List<FrameTiming> values) => callback!(values);
+}
+
+FrameTiming _frame(int start, {int build = 1000, int raster = 1000}) =>
+    FrameTiming(
+      vsyncStart: start,
+      buildStart: start,
+      buildFinish: start + build,
+      rasterStart: start + build,
+      rasterFinish: start + build + raster,
+      rasterFinishWallTime: 999999999,
+    );
+
+void main() {
+  test('disabled recording is opt-in and does not read time or register frames',
+      () {
+    final h = _Harness();
+    addTearDown(h.recorder.dispose);
+    expect(h.recorder.isRecording, isFalse);
+    expect(h.recorder.begin(PerformanceOperation.pageFetch), isNull);
+    expect(h.clockReads, 0);
+    expect(h.adds, 0);
+    expect(h.timer, isNull);
+    expect(h.recorder.snapshot()['eventCount'], 0);
+  });
+
+  test('completed spans merge numeric whitelist and cannot mutate reports', () {
+    final h = _Harness();
+    addTearDown(h.recorder.dispose);
+    h.recorder.start();
+    final metrics = <String, num>{
+      'before': 20,
+      'url': 123,
+      'account': 456,
+      'width': double.nan,
+    };
+    final span =
+        h.recorder.begin(PerformanceOperation.pagePublish, metrics: metrics)!;
+    metrics['before'] = 999;
+    h.now += 450;
+    span.finish(metrics: {'after': 40, 'bytes': double.infinity});
+    span.finish(metrics: {'after': 100});
+    final snapshot = h.recorder.snapshot();
+    expect(snapshot['eventCount'], 1);
+    final event = (snapshot['events'] as List).single as Map;
+    expect(event['startUs'], 0);
+    expect(event['durationUs'], 450);
+    expect(event['metrics'], {'before': 20, 'after': 40});
+    (event['metrics'] as Map)['before'] = 777;
+    final encoded = jsonDecode(h.recorder.exportJson());
+    expect(encoded['events'][0]['metrics']['before'], 20);
+    expect(encoded['operations']['pagePublish']['count'], 1);
+    expect(encoded['operations']['pagePublish']['maxUs'], 450);
+    expect(encoded['operations']['pagePublish']['totalUs'], 450);
+  });
+
+  test('batched frames retain actual timestamps and exclude pre-session work',
+      () {
+    final h = _Harness();
+    addTearDown(h.recorder.dispose);
+    h.recorder.start();
+    h.now += 10000;
+    final span = h.recorder.begin(PerformanceOperation.imageLoad)!;
+    h.now += 1000;
+    span.finish();
+    h.now += 250000;
+    h.frames([
+      _frame(999000, build: 30000),
+      _frame(1009500, build: 11000),
+    ]);
+    final data = h.recorder.snapshot();
+    final frame = (data['frames'] as List).single as Map;
+    final event = (data['events'] as List).single as Map;
+    expect(frame['startUs'], 9500);
+    expect(frame['buildUs'], 11000);
+    expect(event['startUs'], 10000);
+    expect(event['durationUs'], 1000);
+    expect(data['frameCount'], 1);
+    expect(data['framesOver8333us'], 1);
+    expect(data['framesOver16667us'], 0);
+    expect(h.recorder.exportJson(), isNot(contains('999999999')));
+  });
+
+  test('bounded rings retain totals without labeling pipelined duration as FPS',
+      () {
+    final h = _Harness(maxEvents: 2, maxFrames: 2);
+    addTearDown(h.recorder.dispose);
+    h.recorder.start();
+    for (var index = 0; index < 3; index++) {
+      final span = h.recorder.begin(PerformanceOperation.pageFilter)!;
+      h.now += 100;
+      span.finish();
+    }
+    h.frames([
+      _frame(1000000, build: 6000, raster: 6000),
+      _frame(1020000, build: 8334),
+      _frame(1040000, raster: 17000),
+    ]);
+    final data = h.recorder.snapshot();
+    expect(data['eventCount'], 3);
+    expect(data['frameCount'], 3);
+    expect(data['retainedEvents'], 2);
+    expect(data['retainedFrames'], 2);
+    expect(data['droppedEventCount'], 1);
+    expect(data['droppedFrameCount'], 1);
+    expect(data['framesOver8333us'], 2);
+    expect(data['framesOver16667us'], 1);
+    expect(data['maxBuildUs'], 8334);
+    expect(data['maxRasterUs'], 17000);
+    expect((data['frames'] as List).first['startUs'], 20000);
+    expect((data['operations'] as Map)['pageFilter']['count'], 3);
+  });
+
+  test('separate bounded slow-frame history survives later smooth scrolling',
+      () {
+    final h = _Harness(maxFrames: 2, maxSlowFrames: 2);
+    addTearDown(h.recorder.dispose);
+    h.recorder.start();
+    h.frames([
+      _frame(1000000, build: 20000),
+      _frame(1020000),
+      _frame(1040000),
+      _frame(1060000),
+    ]);
+    var data = h.recorder.snapshot();
+    expect((data['frames'] as List).first['startUs'], 40000);
+    expect((data['slowFrames'] as List).single['startUs'], 0);
+    expect(data['retainedSlowFrames'], 1);
+    h.frames([
+      _frame(1080000, raster: 18000),
+      _frame(1100000, build: 30000),
+    ]);
+    data = h.recorder.snapshot();
+    expect(data['retainedSlowFrames'], 2);
+    expect(data['droppedSlowFrameCount'], 1);
+    expect((data['slowFrames'] as List).first['startUs'], 80000);
+    expect(data['framesOver8333us'], 3);
+  });
+
+  test('stop detaches timing collection and invalidates unfinished spans', () {
+    final h = _Harness();
+    addTearDown(h.recorder.dispose);
+    h.recorder.start();
+    h.recorder.start();
+    expect(h.adds, 1);
+    final oldSpan = h.recorder.begin(PerformanceOperation.imageLoad)!;
+    h.now += 1200;
+    h.recorder.stop();
+    expect(h.removes, 1);
+    expect(h.timer!.isActive, isFalse);
+    h.now += 100000;
+    h.frames([_frame(h.now)]);
+    expect(h.recorder.snapshot()['frameCount'], 0);
+    expect(h.recorder.snapshot()['sessionDurationUs'], 1200);
+    h.recorder.start();
+    oldSpan.finish();
+    expect(h.recorder.snapshot()['eventCount'], 0);
+    expect(h.recorder.snapshot()['sessionDurationUs'], 0);
+  });
+
+  test('clear stops collection and does not accept old completions', () {
+    final h = _Harness();
+    addTearDown(h.recorder.dispose);
+    h.recorder.start();
+    final pending = h.recorder.begin(PerformanceOperation.imageLoad)!;
+    h.recorder.begin(PerformanceOperation.pagePublish)!.finish();
+    h.recorder.clear();
+    expect(h.recorder.isRecording, isFalse);
+    expect(h.removes, 1);
+    expect(h.timer!.isActive, isFalse);
+    expect(h.recorder.snapshot()['eventCount'], 0);
+    expect(h.recorder.snapshot()['sessionDurationUs'], 0);
+    h.recorder.start();
+    pending.finish();
+    expect(h.recorder.snapshot()['eventCount'], 0);
+  });
+
+  test('session stops automatically and only lifecycle changes notify UI', () {
+    final h = _Harness();
+    addTearDown(h.recorder.dispose);
+    var notifications = 0;
+    h.recorder.addListener(() => notifications++);
+    h.recorder.start();
+    expect(h.limit, const Duration(minutes: 5));
+    expect(notifications, 1);
+    for (var index = 0; index < 50; index++) {
+      h.recorder.begin(PerformanceOperation.imageLoad)!.finish();
+      h.frames([_frame(h.now)]);
+    }
+    expect(notifications, 1);
+    h.now += const Duration(minutes: 5).inMicroseconds;
+    h.timer!.fire();
+    expect(h.recorder.isRecording, isFalse);
+    expect(h.removes, 1);
+    expect(notifications, 2);
+    expect(h.recorder.snapshot()['sessionDurationUs'], 300000000);
+  });
+
+  test('dispose cancels collection and cannot restart a stale recorder', () {
+    final h = _Harness();
+    h.recorder.start();
+    final span = h.recorder.begin(PerformanceOperation.pageFetch)!;
+    h.recorder.dispose();
+    h.recorder.start();
+    span.finish();
+    expect(h.adds, 1);
+    expect(h.removes, 1);
+    expect(h.timer!.isActive, isFalse);
+    expect(h.recorder.snapshot()['eventCount'], 0);
+  });
+}
