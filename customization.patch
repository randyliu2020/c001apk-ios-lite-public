+            }))),
+      ))));
+      await tester.pumpAndSettle();
+      final roots = find.byType(FeedReplyCard).evaluate().toList();
+      var elements = 0;
+      void count(Element element) {
+        elements++;
+        element.visitChildElements(count);
+      }
+
+      roots.forEach(count);
+      final result = (
+        find.byType(HtmlWidget).evaluate().length,
+        elements,
+        List.generate(
+            20, (index) => tester.getSize(find.byKey(ValueKey(index))))
