+import 'dart:async';
+import 'dart:ui' as ui;
+
+import 'package:c001apk_flutter/components/image_load_probe.dart';
+import 'package:c001apk_flutter/logic/performance/performance_recorder.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+class _PendingImage extends ImageProvider<_PendingImage> {
+  final result = Completer<ImageInfo>();
+  int loads = 0;
+
+  @override
+  Future<_PendingImage> obtainKey(ImageConfiguration configuration) =>
+      SynchronousFuture(this);
+
+  @override
+  ImageStreamCompleter loadImage(
+      _PendingImage key, ImageDecoderCallback decode) {
+    loads++;
+    return OneFrameImageStreamCompleter(result.future);
+  }
+}
+
+class _DeferPhysics extends ScrollPhysics {
+  const _DeferPhysics({super.parent});
+  @override
+  _DeferPhysics applyTo(ScrollPhysics? ancestor) =>
+      _DeferPhysics(parent: buildParent(ancestor));
+  @override
+  bool recommendDeferredLoading(
+          double velocity, ScrollMetrics metrics, BuildContext context) =>
+      true;
+}
+
+void main() {
+  late PerformanceRecorder recorder;
+  var now = 0;
+  setUp(() {
+    now = 1000;
+    recorder = PerformanceRecorder.forTesting(
+        clock: () => now,
+        addFrameCallback: (_) {},
+        removeFrameCallback: (_) {});
+  });
+  tearDown(() {
+    recorder.dispose();
+    PaintingBinding.instance.imageCache.clear();
+    PaintingBinding.instance.imageCache.clearLiveImages();
+  });
+
+  Widget probe(_PendingImage provider, {Widget? child}) => ImageLoadProbe(
+      provider: provider,
+      recorder: recorder,
+      child: child ??
+          Image(
+            image: provider,
+            width: 160,
+            height: 120,
+            fit: BoxFit.contain,
+            errorBuilder: (_, __, ___) => const Text('image failed'),
+          ));
+
+  Future<ui.Image> pixels(WidgetTester tester) async =>
+      (await tester.runAsync(() async {
+        final picture = ui.PictureRecorder();
+        Canvas(picture).drawRect(
+            const Rect.fromLTWH(0, 0, 800, 600), Paint()..color = Colors.blue);
+        final drawing = picture.endRecording();
+        final image = await drawing.toImage(800, 600);
+        drawing.dispose();
+        return image;
+      }))!;
+
+  testWidgets('disabled diagnostics never resolve an additional image',
+      (tester) async {
+    final provider = _PendingImage();
+    await tester.pumpWidget(
+        MaterialApp(home: probe(provider, child: const SizedBox.shrink())));
+    expect(provider.loads, 0);
+    expect(recorder.snapshot()['eventCount'], 0);
+  });
+
+  testWidgets('probe and visible image share one load and unchanged pixels',
+      (tester) async {
+    recorder.start();
+    final provider = _PendingImage();
+    await tester.pumpWidget(MaterialApp(home: Center(child: probe(provider))));
+    expect(provider.loads, 1);
+    now += 18000;
+    provider.result.complete(ImageInfo(image: await pixels(tester)));
+    await tester.pumpAndSettle();
+    final raw = tester.widget<RawImage>(find.byType(RawImage));
+    expect(raw.image!.width, 800);
+    expect(raw.image!.height, 600);
+    expect(raw.fit, BoxFit.contain);
+    expect(provider.loads, 1);
+    final events = recorder.snapshot()['events'] as List;
+    expect(events, hasLength(1));
+    expect(events.single['durationUs'], 18000);
+    expect(events.single['metrics']['width'], 800);
+    expect(events.single['metrics']['height'], 600);
+    expect(events.single['metrics']['success'], 1);
+    await tester.pumpWidget(const SizedBox.shrink());
+    expect(recorder.snapshot()['eventCount'], 1);
+    recorder.stop();
+  });
+
+  testWidgets('failed loads are counted without exposing errors or URLs',
+      (tester) async {
+    recorder.start();
+    final provider = _PendingImage();
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    provider.result
+        .completeError(StateError('https://private.test/token=secret'));
+    await tester.pumpAndSettle();
+    expect(find.text('image failed'), findsOneWidget);
+    expect(recorder.exportJson(), isNot(contains('private.test')));
+    expect(recorder.exportJson(), isNot(contains('secret')));
+    expect(
+        (recorder.snapshot()['events'] as List).single['metrics']['failed'], 1);
+    expect(tester.takeException(), isNull);
+    recorder.stop();
+  });
+
+  testWidgets('recycled row cancels old image observation', (tester) async {
+    recorder.start();
+    final old = _PendingImage();
+    final next = _PendingImage();
+    await tester.pumpWidget(MaterialApp(home: probe(old)));
+    await tester.pumpWidget(MaterialApp(home: probe(next)));
+    final image = await pixels(tester);
+    old.result.complete(ImageInfo(image: image.clone()));
+    next.result.complete(ImageInfo(image: image));
+    await tester.pumpAndSettle();
+    final events = recorder.snapshot()['events'] as List;
+    expect(events, hasLength(2));
+    expect(events.first['metrics']['cancelled'], 1);
+    expect(events.last['metrics']['success'], 1);
+    expect(old.loads, 1);
+    expect(next.loads, 1);
+    recorder.stop();
+  });
+
+  testWidgets('stopping collection does not interrupt the visible image',
+      (tester) async {
+    recorder.start();
+    final provider = _PendingImage();
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    recorder.stop();
+    provider.result.complete(ImageInfo(image: await pixels(tester)));
+    await tester.pumpAndSettle();
+    expect(tester.widget<RawImage>(find.byType(RawImage)).image, isNotNull);
+    expect(recorder.snapshot()['eventCount'], 0);
+    expect(provider.loads, 1);
+  });
+
+  testWidgets('measurement preserves fast-scroll deferred loading',
+      (tester) async {
+    recorder.start();
+    final provider = _PendingImage();
+    await tester.pumpWidget(MaterialApp(
+        home: ListView(
+      physics: const _DeferPhysics(),
+      children: [probe(provider), const SizedBox(height: 2000)],
+    )));
+    await tester.pump(const Duration(milliseconds: 16));
+    expect(provider.loads, 0);
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pump();
+    expect(provider.loads, 0);
+    expect(
+        (recorder.snapshot()['events'] as List).single['metrics']['cancelled'],
+        1);
+    recorder.stop();
+  });
+
+  testWidgets('new session observes an unfinished image without reloading',
+      (tester) async {
+    recorder.start();
+    final provider = _PendingImage();
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    recorder.stop();
+    now += 50000;
+    recorder.start();
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    now += 15000;
+    provider.result.complete(ImageInfo(image: await pixels(tester)));
+    await tester.pumpAndSettle();
+    final events = recorder.snapshot()['events'] as List;
+    expect(events, hasLength(1));
+    expect(events.single['durationUs'], 15000);
+    expect(provider.loads, 1);
+    recorder.stop();
+  });
+
+  testWidgets('synchronous cache completion uses one sample', (tester) async {
+    final provider = _PendingImage();
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    provider.result.complete(ImageInfo(image: await pixels(tester)));
+    await tester.pumpAndSettle();
+    recorder.start();
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    await tester.pump();
+    final events = recorder.snapshot()['events'] as List;
+    expect(events, hasLength(1));
+    expect(events.single['metrics']['synchronous'], 1);
+    expect(provider.loads, 1);
+    await tester.pumpWidget(MaterialApp(home: probe(provider)));
+    expect(recorder.snapshot()['eventCount'], 1);
+    recorder.stop();
+  });
+}
diff --git a/apps/flutter/test/lite/ios_back_gesture_test.dart b/apps/flutter/test/lite/ios_back_gesture_test.dart
new file mode 100644
index 0000000..da54e48
--- /dev/null
+++ b/apps/flutter/test/lite/ios_back_gesture_test.dart
@@ -0,0 +1,326 @@
+import 'package:c001apk_flutter/router/app_pages.dart';
+import 'package:c001apk_flutter/router/page_transitions.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+
+void main() {
+  tearDown(Get.reset);
+
+  Future<void> open(WidgetTester tester,
+      {String routeName = '/feed/:id', Widget? content,
+      Widget? previous, ValueNotifier<bool>? canPop}) async {
+    await tester.binding.setSurfaceSize(const Size(390, 844));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final production = AppPages.getPages.firstWhere((p) => p.name == routeName);
+    final page = content ?? const Scaffold(body: Center(child: Text('帖子')));
+    await tester.pumpWidget(GetMaterialApp(
+      popGesture: false,
+      customTransition: AppPageTransition(),
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      initialRoute: '/',
+      getPages: [
+        GetPage(name: '/', page: () => previous ??
+            const Scaffold(body: Text('列表'))),
+        production.copy(page: () => canPop == null ? page :
+            ValueListenableBuilder<bool>(valueListenable: canPop,
+                builder: (_, value, __) => PopScope(canPop: value, child: page))),
+      ],
+    ));
+    Get.toNamed(routeName.replaceAll(':id', '123'));
+    await tester.pumpAndSettle();
+  }
+
+  Rect bounds(WidgetTester tester) => tester.getRect(find.ancestor(
+      of: find.text('帖子'), matching: find.byType(Scaffold)).first);
+
+  Future<void> complete(WidgetTester tester, Offset start) async {
+    final pointer = await tester.startGesture(start);
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump(const Duration(milliseconds: 80));
+    await pointer.moveBy(const Offset(245, 0));
+    await tester.pump(const Duration(milliseconds: 300));
+    await pointer.up();
+    await tester.pumpAndSettle();
+  }
+
+  testWidgets('production feed supports content swipe and keeps list offset',
+      (tester) async {
+    final list = ScrollController(initialScrollOffset: 420);
+    addTearDown(list.dispose);
+    await open(tester, previous: Scaffold(body: ListView.builder(
+        controller: list, itemCount: 60, itemExtent: 60,
+        itemBuilder: (_, index) => Text('列表条目 $index'))));
+    final pointer = await tester.startGesture(const Offset(90, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(100, 0));
+    await tester.pump();
+    expect(Get.key.currentState!.userGestureInProgress, isTrue);
+    expect(bounds(tester).left, closeTo(100, 2));
+    await pointer.moveBy(const Offset(150, 0));
+    await tester.pump(const Duration(milliseconds: 300));
+    await pointer.up();
+    await tester.pumpAndSettle();
+    expect(find.text('帖子'), findsNothing);
+    expect(list.offset, closeTo(420, 0.1));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await complete(tester, const Offset(90, 400));
+    expect(list.offset, closeTo(420, 0.1));
+    expect(Get.key.currentState!.canPop(), isFalse,
+        reason: 'The first route cannot be swiped out of the app.');
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('short swipe and pointer cancellation return to the same page',
+      (tester) async {
+    await open(tester);
+    final original = bounds(tester);
+    final pointer = await tester.startGesture(const Offset(90, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(75, 0));
+    await tester.pump(const Duration(milliseconds: 300));
+    await pointer.up();
+    await tester.pumpAndSettle();
+    expect(bounds(tester), original);
+    final cancelled = await tester.startGesture(const Offset(90, 400));
+    await cancelled.moveBy(const Offset(250, 0));
+    await tester.pump();
+    await cancelled.cancel();
+    await tester.pumpAndSettle();
+    expect(bounds(tester), original);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('leading edge remains available for image routes', (tester) async {
+    await open(tester, routeName: '/imageview');
+    await complete(tester, const Offset(90, 400));
+    expect(find.text('帖子'), findsOneWidget,
+        reason: 'Content swipes in a gallery belong to its images.');
+    await complete(tester, const Offset(5, 400));
+    expect(find.text('帖子'), findsNothing);
+    expect(find.text('列表'), findsOneWidget);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('a child horizontal pager wins over content back', (tester) async {
+    final pager = PageController(initialPage: 1);
+    addTearDown(pager.dispose);
+    await open(tester, content: Scaffold(body: PageView(
+        controller: pager, children: const [Center(child: Text('图片一')),
+          Center(child: Text('图片二'))])));
+    await complete(tester, const Offset(90, 400));
+    expect(pager.page, closeTo(0, 0.01));
+    expect(Get.key.currentState!.canPop(), isTrue);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('vertical scroll and leftward swipe do not pop', (tester) async {
+    final list = ScrollController();
+    addTearDown(list.dispose);
+    await open(tester, content: Scaffold(body: ListView.builder(
+        controller: list, itemCount: 50, itemExtent: 50,
+        itemBuilder: (_, i) => Text('回复 $i'))));
+    await tester.dragFrom(const Offset(160, 500), const Offset(0, -250));
+    await tester.pumpAndSettle();
+    expect(list.offset, greaterThan(100));
+    await tester.dragFrom(const Offset(300, 400), const Offset(-220, 0));
+    await tester.pumpAndSettle();
+    expect(Get.key.currentState!.canPop(), isTrue);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('PopScope protects the route before and during a swipe',
+      (tester) async {
+    final allowed = ValueNotifier(false);
+    addTearDown(allowed.dispose);
+    await open(tester, canPop: allowed);
+    await complete(tester, const Offset(5, 400));
+    expect(find.text('帖子'), findsOneWidget);
+    allowed.value = true;
+    await tester.pump();
+    final pointer = await tester.startGesture(const Offset(90, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(220, 0));
+    await tester.pump();
+    allowed.value = false;
+    await tester.pump();
+    await pointer.up();
+    await tester.pumpAndSettle();
+    expect(find.text('帖子'), findsOneWidget);
+    expect(bounds(tester).left, closeTo(0, 0.01));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('dialog arriving during a drag is never popped by that drag',
+      (tester) async {
+    await open(tester);
+    final pointer = await tester.startGesture(const Offset(90, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(220, 0));
+    await tester.pump();
+    Get.dialog(const AlertDialog(content: Text('保留弹窗')));
+    await tester.pumpAndSettle();
+    await pointer.up();
+    await tester.pumpAndSettle();
+    expect(find.text('保留弹窗'), findsOneWidget);
+    Get.back();
+    await tester.pumpAndSettle();
+    expect(bounds(tester).left, closeTo(0, 0.01));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('reduced motion retains back navigation without visual movement',
+      (tester) async {
+    tester.platformDispatcher.accessibilityFeaturesTestValue =
+        const FakeAccessibilityFeatures(disableAnimations: true);
+    addTearDown(tester.platformDispatcher.clearAccessibilityFeaturesTestValue);
+    await open(tester);
+    final initial = bounds(tester);
+    final pointer = await tester.startGesture(const Offset(90, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(220, 0));
+    await tester.pump();
+    expect(bounds(tester), initial);
+    await pointer.up();
+    await tester.pumpAndSettle();
+    expect(find.text('列表'), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('focused text keeps content editing but allows safe edge back',
+      (tester) async {
+    await open(tester, content: const Scaffold(body: TextField()));
+    await tester.tap(find.byType(TextField));
+    await tester.enterText(find.byType(TextField), '草稿');
+    await tester.pumpAndSettle();
+    await complete(tester, const Offset(90, 400));
+    expect(find.text('草稿'), findsOneWidget);
+    expect(Get.key.currentState!.canPop(), isTrue);
+    await complete(tester, const Offset(5, 400));
+    expect(find.text('列表'), findsOneWidget);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('a normal tap does not poison the next back gesture',
+      (tester) async {
+    await open(tester);
+    await tester.tap(find.text('帖子'));
+    await tester.pumpAndSettle();
+    await complete(tester, const Offset(90, 400));
+    expect(find.text('列表'), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('blank non-scrollable content waits for a rightward drag',
+      (tester) async {
+    // No child gesture recognizer competes in this blank area. Pump after each
+    // down so the arena can accept its only member before any movement occurs.
+    await open(tester);
+    final original = bounds(tester);
+    final tap = await tester.startGesture(const Offset(90, 400));
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tap.up();
+    await tester.pumpAndSettle();
+    expect(bounds(tester), original);
+
+    final left = await tester.startGesture(const Offset(300, 400));
+    await tester.pump(const Duration(milliseconds: 50));
+    await left.moveBy(const Offset(-35, 0));
+    await tester.pump();
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await left.moveBy(const Offset(-200, 0));
+    await left.up();
+    await tester.pumpAndSettle();
+    expect(bounds(tester), original);
+
+    final right = await tester.startGesture(const Offset(90, 400));
+    await tester.pump(const Duration(milliseconds: 50));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await right.moveBy(const Offset(35, 0));
+    await tester.pump();
+    expect(Get.key.currentState!.userGestureInProgress, isTrue);
+    await right.moveBy(const Offset(220, 0));
+    await tester.pump(const Duration(milliseconds: 300));
+    await right.up();
+    await tester.pumpAndSettle();
+    expect(find.text('帖子'), findsNothing);
+    expect(find.text('列表'), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('second finger on exposed previous page cancels a back drag',
+      (tester) async {
+    await open(tester);
+    final first = await tester.startGesture(const Offset(80, 400), pointer: 1);
+    await first.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await first.moveBy(const Offset(220, 0));
+    await tester.pump();
+    const secondPosition = Offset(80, 600);
+    expect(Get.key.currentState!.userGestureInProgress, isTrue);
+    expect(bounds(tester).left, greaterThan(secondPosition.dx),
+        reason: 'The second finger must land outside the translated post.');
+    final second = await tester.startGesture(secondPosition, pointer: 2);
+    await tester.pump();
+    await first.up();
+    await second.up();
+    await tester.pumpAndSettle();
+    expect(find.text('帖子'), findsOneWidget);
+    expect(bounds(tester).left, closeTo(0, 0.01));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('changing motion preference mid-drag keeps text state',
+      (tester) async {
+    addTearDown(tester.platformDispatcher.clearAccessibilityFeaturesTestValue);
+    await open(tester, content: const Scaffold(body: TextField()));
+    await tester.tap(find.byType(TextField));
+    await tester.enterText(find.byType(TextField), '保留当前编辑内容');
+    await tester.pumpAndSettle();
+    final pointer = await tester.startGesture(const Offset(5, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(120, 0));
+    await tester.pump();
+    tester.platformDispatcher.accessibilityFeaturesTestValue =
+        const FakeAccessibilityFeatures(disableAnimations: true);
+    await tester.pump();
+    await pointer.cancel();
+    await tester.pumpAndSettle();
+    expect(find.text('保留当前编辑内容'), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('two fingers down before drag recognition cannot initiate back',
+      (tester) async {
+    await open(tester);
+    final first = await tester.startGesture(const Offset(5, 400), pointer: 1);
+    final second = await tester.startGesture(const Offset(180, 500), pointer: 2);
+    await first.moveBy(const Offset(260, 0));
+    await tester.pump();
+    await first.up();
+    await second.up();
+    await tester.pumpAndSettle();
+    expect(bounds(tester).left, closeTo(0, 0.01));
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await complete(tester, const Offset(90, 400));
+    expect(find.text('列表'), findsOneWidget);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+}
diff --git a/apps/flutter/test/lite/ios_feed_status_bar_test.dart b/apps/flutter/test/lite/ios_feed_status_bar_test.dart
new file mode 100644
index 0000000..3705046
--- /dev/null
+++ b/apps/flutter/test/lite/ios_feed_status_bar_test.dart
@@ -0,0 +1,100 @@
+import 'dart:io';
+
+import 'package:c001apk_flutter/logic/network/request.dart';
+import 'package:c001apk_flutter/pages/feed/feed_page.dart';
+import 'package:c001apk_flutter/utils/global_data.dart';
+import 'package:c001apk_flutter/utils/storage_util.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:hive/hive.dart';
+
+import '../network/guest_detail_test.dart' show GuestDetailAdapter;
+
+void main() {
+  late Directory directory;
+  late GuestDetailAdapter adapter;
+
+  setUpAll(() async {
+    directory = await Directory.systemTemp.createTemp('ios-feed-status-bar-');
+    Hive.init(directory.path);
+    GStorage.settings = await Hive.openBox('settings');
+    GStorage.blackList = await Hive.openBox('blackList');
+    GStorage.favFeed = await Hive.openBox('favFeed');
+    await GStorage.settings.putAll({
+      SettingsBoxKey.xAppDevice: 'synthetic-test-device',
+      SettingsBoxKey.versionCode: '2604201',
+      SettingsBoxKey.versionName: '16.2.0',
+      SettingsBoxKey.apiVersion: '16',
+      SettingsBoxKey.sdkInt: '33',
+      SettingsBoxKey.userAgent: 'SyntheticTest/1.0',
+      SettingsBoxKey.recordHistory: false,
+      // Keep replies enabled, so an accidental refresh is visible as a request.
+      SettingsBoxKey.szlmId: 'synthetic-test-identity',
+    });
+    Request();
+  });
+  setUp(() {
+    GlobalData().isLogin = false;
+    GlobalData().SESSID = '';
+    adapter = GuestDetailAdapter();
+    adapter.apiBody = {
+      'data': {
+        ...(adapter.webBody['data'] as Map<String, dynamic>),
+        'feedTypeName': '动态',
+        'message': List.filled(80, '离线合成帖子正文，用于验证状态栏回到顶部。').join('\n'),
+      },
+    };
+    Request.dio.httpClientAdapter = adapter;
+  });
+  tearDown(Get.reset);
+  tearDownAll(() async {
+    await Hive.close();
+    await directory.delete(recursive: true);
+  });
+
+  testWidgets('iOS status bar returns the production feed to top without refresh',
+      (tester) async {
+    tester.view.devicePixelRatio = 1;
+    tester.view.physicalSize = const Size(390, 844);
+    tester.view.padding = const FakeViewPadding(top: 47, bottom: 34);
+    addTearDown(tester.view.resetDevicePixelRatio);
+    addTearDown(tester.view.resetPhysicalSize);
+    addTearDown(tester.view.resetPadding);
+
+    await tester.pumpWidget(GetMaterialApp(
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      home: const FeedPage(id: '123'),
+    ));
+    await tester.runAsync(
+        () => Future<void>.delayed(const Duration(milliseconds: 100)));
+    await tester.pumpAndSettle();
+    final reading = find.byKey(const PageStorageKey('feed-reading:123'));
+    expect(reading, findsOneWidget);
+    final controller = tester.widget<CustomScrollView>(reading).controller!;
+    controller.jumpTo(420);
+    await tester.pumpAndSettle();
+    expect(controller.offset, 420);
+    expect(adapter.requests.where((request) =>
+        request.uri.path == '/v6/feed/replyList'), isNotEmpty);
+    final requestsBeforeTap = adapter.requests.length;
+
+    // Deliver the same framework event as an actual iOS status-bar tap.
+    // A title-bar tap or a direct controller call would miss this regression.
+    await tester.binding.defaultBinaryMessenger.handlePlatformMessage(
+      SystemChannels.statusBar.name,
+      SystemChannels.statusBar.codec
+          .encodeMethodCall(const MethodCall('handleScrollToTop')),
+      (_) {},
+    );
+    await tester.pumpAndSettle();
+    expect(controller.offset, closeTo(0, 0.01));
+    expect(tester.widget<CustomScrollView>(reading).controller, same(controller));
+    expect(adapter.requests.length, requestsBeforeTap,
+        reason: 'Returning to the top must not refresh the post or its replies.');
+    expect(find.byType(FeedPage), findsOneWidget);
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+}
diff --git a/apps/flutter/test/lite/ios_home_status_bar_test.dart b/apps/flutter/test/lite/ios_home_status_bar_test.dart
new file mode 100644
index 0000000..b15257c
--- /dev/null
+++ b/apps/flutter/test/lite/ios_home_status_bar_test.dart
@@ -0,0 +1,238 @@
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:c001apk_flutter/components/adaptive_main_scaffold.dart';
+import 'package:c001apk_flutter/components/status_bar_scroll.dart';
+import 'package:c001apk_flutter/logic/model/feed/datum.dart';
+import 'package:c001apk_flutter/logic/network/request.dart';
+import 'package:c001apk_flutter/pages/home/feed/home_feed_controller.dart';
+import 'package:c001apk_flutter/pages/home/home_page.dart';
+import 'package:c001apk_flutter/pages/home/return_top_controller.dart';
+import 'package:c001apk_flutter/pages/message/message_page.dart';
+import 'package:c001apk_flutter/utils/global_data.dart';
+import 'package:c001apk_flutter/utils/storage_util.dart';
+import 'package:dio/dio.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:hive/hive.dart';
+
+class _EmptyTransport implements HttpClientAdapter {
+  int requests = 0;
+
+  @override
+  Future<ResponseBody> fetch(RequestOptions options,
+      Stream<Uint8List>? requestStream, Future<void>? cancelFuture) async {
+    requests++;
+    return ResponseBody.fromString('{"data":[]}', 200, headers: {
+      Headers.contentTypeHeader: ['application/json']
+    });
+  }
+
+  @override
+  void close({bool force = false}) {}
+}
+
+Future<void> _statusBarTap(WidgetTester tester) async {
+  await tester.binding.defaultBinaryMessenger.handlePlatformMessage(
+    SystemChannels.statusBar.name,
+    SystemChannels.statusBar.codec
+        .encodeMethodCall(const MethodCall('handleScrollToTop')),
+    (_) {},
+  );
+  await tester.pumpAndSettle();
+}
+
+void _phone(WidgetTester tester, {double height = 844}) {
+  tester.view.devicePixelRatio = 1;
+  tester.view.physicalSize = Size(390, height);
+  tester.view.padding = const FakeViewPadding(top: 47, bottom: 34);
+  addTearDown(tester.view.resetDevicePixelRatio);
+  addTearDown(tester.view.resetPhysicalSize);
+  addTearDown(tester.view.resetPadding);
+}
+
+void main() {
+  late Directory directory;
+  late _EmptyTransport transport;
+
+  setUpAll(() async {
+    directory = await Directory.systemTemp.createTemp('ios-home-status-bar-');
+    Hive.init(directory.path);
+    GStorage.settings = await Hive.openBox('settings');
+    GStorage.blackList = await Hive.openBox('blackList');
+    Request();
+  });
+  setUp(() async {
+    await GStorage.settings.clear();
+    await GStorage.settings.putAll({
+      SettingsBoxKey.xAppDevice: 'synthetic-status-bar-device',
+      SettingsBoxKey.floatingNavigation: false,
+    });
+    GlobalData().isLogin = false;
+    GlobalData().SESSID = '';
+    transport = _EmptyTransport();
+    Request.dio.httpClientAdapter = transport;
+    Get.testMode = true;
+  });
+  tearDown(Get.reset);
+  tearDownAll(() async {
+    await Hive.close();
+    await directory.delete(recursive: true);
+  });
+
+  Future<HomeFeedController> populate(
+      WidgetTester tester, String tag) async {
+    await tester.runAsync(
+        () => Future<void>.delayed(const Duration(milliseconds: 30)));
+    final controller = Get.find<HomeFeedController>(tag: tag);
+    controller.isEnd = true;
+    controller.publishItems(List.generate(
+        30,
+        (index) => Datum(
+              id: 'synthetic-$tag-$index',
+              entityType: 'feed',
+              uid: '123',
+              username: '离线测试',
+              message: '列表回顶验证 $index',
+              dateline: 1700000000,
+            )));
+    await tester.pumpAndSettle();
+    return controller;
+  }
+
+  testWidgets('production home targets the current category without requests',
+      (tester) async {
+    _phone(tester);
+    Get.put(ReturnTopController(), tag: 'home');
+    await tester.pumpWidget(GetMaterialApp(
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      home: StatusBarScrollHost(
+        child: AdaptiveMainScaffold(
+          selectedIndex: 0,
+          onDestinationSelected: (_) {},
+          bodyBuilder: (_, __) => const HomePage(),
+        ),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    final home = await populate(tester, 'FEED');
+    home.scrollController!.jumpTo(420);
+    await tester.pumpAndSettle();
+    var requestsBeforeTap = transport.requests;
+    await _statusBarTap(tester);
+    expect(home.scrollController!.offset, closeTo(0, 0.01));
+    expect(transport.requests, requestsBeforeTap);
+
+    home.scrollController!.jumpTo(320);
+    await tester.tap(find.text('热门').first);
+    await tester.pumpAndSettle();
+    final hot = await populate(tester, 'HOT');
+    hot.scrollController!.jumpTo(460);
+    await tester.pumpAndSettle();
+    requestsBeforeTap = transport.requests;
+    await _statusBarTap(tester);
+    expect(hot.scrollController!.offset, closeTo(0, 0.01));
+    expect(home.scrollController!.offset, 320);
+    expect(transport.requests, requestsBeforeTap);
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('production profile returns to top without refreshing',
+      (tester) async {
+    _phone(tester, height: 600);
+    await tester.pumpWidget(GetMaterialApp(
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      home: StatusBarScrollHost(
+        child: AdaptiveMainScaffold(
+          selectedIndex: 2,
+          onDestinationSelected: (_) {},
+          bodyBuilder: (_, __) => const MessagePage(),
+        ),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    final controller =
+        tester.widget<CustomScrollView>(find.byType(CustomScrollView)).controller!;
+    expect(controller.position.maxScrollExtent, greaterThan(0));
+    controller.jumpTo(controller.position.maxScrollExtent);
+    await tester.pumpAndSettle();
+    final requestsBeforeTap = transport.requests;
+    await _statusBarTap(tester);
+    expect(controller.offset, closeTo(0, 0.01));
+    expect(transport.requests, requestsBeforeTap);
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+  });
+
+  testWidgets('kept-alive main destinations expose only the visible list',
+      (tester) async {
+    _phone(tester);
+    final controllers = List.generate(3, (_) => ScrollController());
+    var selected = 0;
+    var showCurrent = true;
+    var refreshes = 0;
+    late StateSetter update;
+    await tester.pumpWidget(MaterialApp(
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      home: StatusBarScrollHost(
+        child: StatefulBuilder(builder: (context, setState) {
+          update = setState;
+          return Scaffold(
+            body: IndexedStack(
+              index: selected,
+              children: List.generate(3, (index) => StatusBarScrollBranch(
+                    active: selected == index,
+                    child: showCurrent || selected != index
+                        ? StatusBarScrollTarget(
+                            controller: controllers[index],
+                            child: RefreshIndicator(
+                              onRefresh: () async {
+                                refreshes++;
+                              },
+                              child: ListView.builder(
+                                controller: controllers[index],
+                                itemCount: 50,
+                                itemExtent: 80,
+                                itemBuilder: (_, row) => Text('$index / $row'),
+                              ),
+                            ),
+                          )
+                        : const SizedBox.expand(),
+                  )),
+            ),
+          );
+        }),
+      ),
+    ));
+    await tester.pumpAndSettle();
+    for (var active = 0; active < 3; active++) {
+      for (final controller in controllers) {
+        controller.jumpTo(400);
+      }
+      update(() => selected = active);
+      await tester.pumpAndSettle();
+      await _statusBarTap(tester);
+      for (var index = 0; index < 3; index++) {
+        expect(controllers[index].offset,
+            closeTo(index == active ? 0 : 400, 0.01));
+      }
+      expect(refreshes, 0);
+    }
+    // Removing the active list must clear its registration, not fall back to
+    // an offstage page. Empty/loading states have no scroll target.
+    update(() => showCurrent = false);
+    await tester.pumpAndSettle();
+    await _statusBarTap(tester);
+    expect(controllers[0].offset, 400);
+    expect(controllers[1].offset, 400);
+    expect(refreshes, 0);
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+    for (final controller in controllers) {
+      controller.dispose();
+    }
+  });
+}
diff --git a/apps/flutter/test/lite/ios_image_gesture_test.dart b/apps/flutter/test/lite/ios_image_gesture_test.dart
new file mode 100644
index 0000000..2f8b0e8
--- /dev/null
+++ b/apps/flutter/test/lite/ios_image_gesture_test.dart
@@ -0,0 +1,331 @@
+import 'dart:ui' as ui;
+
+import 'package:c001apk_flutter/pages/others/imageview_page.dart';
+import 'package:c001apk_flutter/logic/performance/performance_recorder.dart';
+import 'package:c001apk_flutter/router/app_pages.dart';
+import 'package:c001apk_flutter/router/page_transitions.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+import 'package:photo_view/photo_view.dart';
+import 'package:photo_view/photo_view_gallery.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late MemoryImage image;
+
+  setUpAll(() async {
+    // A real, decoded landscape image exercises PhotoView's scale boundaries.
+    // No HTTP, cache-manager plugin, or account is needed by this fixture.
+    final recorder = ui.PictureRecorder();
+    final canvas = ui.Canvas(recorder);
+    canvas.drawRect(const ui.Rect.fromLTWH(0, 0, 800, 600),
+        ui.Paint()..color = const ui.Color(0xff335577));
+    final picture = recorder.endRecording();
+    final decoded = await picture.toImage(800, 600);
+    try {
+      final bytes = await decoded.toByteData(format: ui.ImageByteFormat.png);
+      image = MemoryImage(bytes!.buffer.asUint8List());
+    } finally {
+      decoded.dispose();
+      picture.dispose();
+    }
+  });
+
+  // The app's production transition and dismiss guards use Theme.platform.
+  // A process-wide debug override would outlive the widget-test invariants.
+  tearDown(Get.reset);
+
+  PhotoViewControllerBase controller(WidgetTester tester, int index) => tester
+      .widget<PhotoView>(find.byWidgetPredicate(
+          (widget) => widget is PhotoView && widget.key == ObjectKey(index)))
+      .controller!;
+
+  PageController pages(WidgetTester tester) => tester
+      .widget<PhotoViewGallery>(find.byType(PhotoViewGallery))
+      .pageController!;
+
+  Rect galleryBounds(WidgetTester tester) =>
+      tester.getRect(find.byType(PhotoViewGallery));
+
+  Rect imagePageBounds(WidgetTester tester) => tester.getRect(find.descendant(
+      of: find.byType(ImageViewPage), matching: find.byType(Scaffold)));
+
+  Future<void> open(WidgetTester tester, {int initialPage = 0}) async {
+    await tester.binding.setSurfaceSize(const Size(390, 844));
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final production =
+        AppPages.getPages.firstWhere((page) => page.name == '/imageview');
+    await tester.pumpWidget(GetMaterialApp(
+      popGesture: false,
+      customTransition: AppPageTransition(),
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      initialRoute: '/',
+      getPages: [
+        GetPage(name: '/', page: () => const Scaffold(body: Text('原帖子'))),
+        production.copy(
+            page: () => ImageViewPage(imageProviderBuilder: (_) => image)),
+      ],
+    ));
+    await tester.pumpAndSettle();
+    final context = tester.element(find.byType(Scaffold));
+    await tester.runAsync(() => precacheImage(image, context));
+    Get.toNamed('/imageview', arguments: {
+      'imgList': ['memory://one.png', 'memory://two.png', 'memory://three.png'],
+      'initialPage': initialPage,
+    });
+    await tester.pumpAndSettle();
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(controller(tester, initialPage).scale, isNotNull);
+    expect(tester.takeException(), isNull);
+  }
+
+  Future<void> slowDrag(WidgetTester tester, Offset start, Offset delta,
+      {int steps = 6}) async {
+    final finger = await tester.startGesture(start);
+    for (var step = 1; step <= steps; step++) {
+      await finger.moveTo(start + delta * (step / steps),
+          timeStamp: Duration(microseconds: 300000 * step ~/ steps));
+      await tester.pump(Duration(microseconds: 300000 ~/ steps));
+    }
+    // End stationary, so these cases test distance rather than fling speed.
+    await finger.moveTo(start + delta,
+        timeStamp: const Duration(milliseconds: 650));
+    await tester.pump(const Duration(milliseconds: 350));
+    await finger.up(timeStamp: const Duration(milliseconds: 700));
+    await tester.pumpAndSettle();
+  }
+
+  Future<void> pinchOut(WidgetTester tester) async {
+    final left = await tester.startGesture(const Offset(155, 400), pointer: 1);
+    final right = await tester.startGesture(const Offset(235, 400), pointer: 2);
+    for (var step = 1; step <= 5; step++) {
+      final time = Duration(milliseconds: step * 40);
+      await left.moveTo(Offset(155 - step * 20.0, 400), timeStamp: time);
+      await right.moveTo(Offset(235 + step * 20.0, 400), timeStamp: time);
+      await tester.pump(const Duration(milliseconds: 40));
+    }
+    await left.up(timeStamp: const Duration(milliseconds: 300));
+    await right.up(timeStamp: const Duration(milliseconds: 300));
+    await tester.pumpAndSettle();
+  }
+
+  Future<void> finish(WidgetTester tester) async {
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pumpAndSettle();
+    expect(tester.takeException(), isNull);
+  }
+
+  testWidgets('real gallery closes after a downward drag', (tester) async {
+    await open(tester);
+    await slowDrag(tester, const Offset(195, 300), const Offset(0, 320));
+    expect(find.byType(ImageViewPage), findsNothing);
+    expect(find.text('原帖子'), findsOneWidget);
+    expect(Get.key.currentState!.canPop(), isFalse);
+    await finish(tester);
+  });
+
+  testWidgets('recording original image readiness preserves zoom and dismissal',
+      (tester) async {
+    final performance = PerformanceRecorder.instance;
+    performance.start();
+    try {
+      await open(tester);
+      final events = (performance.snapshot()['events'] as List)
+          .where((event) => event['operation'] == 'imageLoad')
+          .toList();
+      expect(events, isNotEmpty);
+      for (final event in events) {
+        expect(event['metrics']['width'], 800);
+        expect(event['metrics']['height'], 600);
+        expect(event['metrics']['screen'], 3);
+      }
+      expect(performance.exportJson(), isNot(contains('memory://')));
+      final contained = controller(tester, 0).scale!;
+      await pinchOut(tester);
+      expect(controller(tester, 0).scale!, greaterThan(contained * 1.2));
+      await slowDrag(tester, const Offset(195, 300), const Offset(0, 250));
+      expect(find.byType(ImageViewPage), findsOneWidget);
+      await slowDrag(tester, const Offset(4, 400), const Offset(290, 0));
+      expect(find.byType(ImageViewPage), findsNothing);
+      await finish(tester);
+    } finally {
+      performance.clear();
+    }
+  });
+
+  testWidgets('short downward and upward drags keep the real gallery open',
+      (tester) async {
+    await open(tester);
+    final original = galleryBounds(tester);
+    await slowDrag(tester, const Offset(195, 350), const Offset(0, 45));
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(galleryBounds(tester).top, closeTo(original.top, 0.1));
+    await slowDrag(tester, const Offset(195, 600), const Offset(0, -280));
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(galleryBounds(tester).top, closeTo(original.top, 0.1));
+    expect(pages(tester).page, closeTo(0, 0.01));
+    await finish(tester);
+  });
+
+  testWidgets('large first movement changes images in both directions',
+      (tester) async {
+    await open(tester, initialPage: 1);
+    // Each movement is 45 px: crossing scale and horizontal thresholds in one
+    // event must not let PhotoView claim a drag on an already contained image.
+    await slowDrag(tester, const Offset(320, 400), const Offset(-270, 0));
+    expect(pages(tester).page, closeTo(2, 0.01));
+    expect(find.text('3/3'), findsOneWidget);
+    await slowDrag(tester, const Offset(65, 400), const Offset(270, 0));
+    expect(pages(tester).page, closeTo(1, 0.01));
+    expect(find.text('2/3'), findsOneWidget);
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await finish(tester);
+  });
+
+  testWidgets('fine continuous content swipes retain normal image paging',
+      (tester) async {
+    await open(tester, initialPage: 1);
+    await slowDrag(tester, const Offset(320, 400), const Offset(-270, 0),
+        steps: 30);
+    expect(pages(tester).page, closeTo(2, 0.01));
+    expect(find.text('3/3'), findsOneWidget);
+    await slowDrag(tester, const Offset(65, 400), const Offset(270, 0),
+        steps: 30);
+    expect(pages(tester).page, closeTo(1, 0.01));
+    expect(find.text('2/3'), findsOneWidget);
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    await finish(tester);
+  });
+
+  testWidgets('real gallery preserves an interactive left-edge return',
+      (tester) async {
+    await open(tester, initialPage: 1);
+    await slowDrag(tester, const Offset(5, 400), const Offset(90, 0));
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(pages(tester).page, closeTo(1, 0.01));
+    await slowDrag(tester, const Offset(5, 400), const Offset(300, 0));
+    expect(find.byType(ImageViewPage), findsNothing);
+    expect(find.text('原帖子'), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await finish(tester);
+  });
+
+  testWidgets(
+      'pinch zoom and enlarged-image panning do not dismiss the gallery',
+      (tester) async {
+    await open(tester);
+    final photo = controller(tester, 0);
+    final initial = photo.scale!;
+    final original = galleryBounds(tester);
+    await pinchOut(tester);
+    expect(photo.scale!, greaterThan(initial * 2.8));
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    final zoomed = photo.scale!;
+    final beforePan = photo.position;
+    await slowDrag(tester, const Offset(195, 350), const Offset(0, 180));
+    expect(photo.position.dy, greaterThan(beforePan.dy + 30));
+    expect(photo.scale!, closeTo(zoomed, 0.01));
+    expect(galleryBounds(tester).top, closeTo(original.top, 0.1));
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(pages(tester).page, closeTo(0, 0.01));
+    await finish(tester);
+  });
+
+  testWidgets('left-edge return also works while the real image is enlarged',
+      (tester) async {
+    await open(tester);
+    final photo = controller(tester, 0);
+    final initial = photo.scale!;
+    await pinchOut(tester);
+    expect(photo.scale!, greaterThan(initial * 2.8));
+    await slowDrag(tester, const Offset(5, 400), const Offset(300, 0));
+    expect(find.byType(ImageViewPage), findsNothing);
+    expect(find.text('原帖子'), findsOneWidget);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await finish(tester);
+  });
+
+  testWidgets('double tap still zooms the real image', (tester) async {
+    await open(tester);
+    final photo = controller(tester, 0);
+    final initial = photo.scale!;
+    await tester.tapAt(const Offset(195, 400));
+    await tester.pump(const Duration(milliseconds: 80));
+    await tester.tapAt(const Offset(195, 400));
+    await tester.pumpAndSettle();
+    expect(photo.scale!, greaterThan(initial * 1.2));
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    await finish(tester);
+  });
+
+  testWidgets('a second finger in the exposed app bar area cancels dismissal',
+      (tester) async {
+    await open(tester);
+    final original = galleryBounds(tester);
+    final first = await tester.startGesture(const Offset(195, 300), pointer: 1);
+    await first.moveBy(const Offset(0, 40),
+        timeStamp: const Duration(milliseconds: 40));
+    await tester.pump();
+    await first.moveBy(const Offset(0, 200),
+        timeStamp: const Duration(milliseconds: 160));
+    await tester.pump();
+    const secondPosition = Offset(80, 20);
+    expect(imagePageBounds(tester).top, greaterThan(secondPosition.dy),
+        reason: 'The second finger lands where the app bar was, outside the '
+            'translated Scaffold and gallery.');
+    final second = await tester.createGesture(pointer: 2);
+    await second.down(secondPosition,
+        timeStamp: const Duration(milliseconds: 180));
+    await tester.pump();
+    await second.up(timeStamp: const Duration(milliseconds: 200));
+    // Keeping the first finger down must not re-arm a canceled gesture.
+    await first.moveBy(const Offset(0, 80),
+        timeStamp: const Duration(milliseconds: 260));
+    await tester.pump();
+    await first.up(timeStamp: const Duration(milliseconds: 300));
+    await tester.pumpAndSettle();
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(galleryBounds(tester).top, closeTo(original.top, 0.1));
+    await finish(tester);
+  });
+
+  testWidgets('pointer cancellation restores the image instead of closing it',
+      (tester) async {
+    await open(tester);
+    final original = galleryBounds(tester);
+    final finger = await tester.startGesture(const Offset(195, 300));
+    await finger.moveBy(const Offset(0, 40));
+    await tester.pump();
+    await finger.moveBy(const Offset(0, 220));
+    await tester.pump();
+    expect(galleryBounds(tester).top, greaterThan(original.top));
+    await finger.cancel();
+    await tester.pumpAndSettle();
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(galleryBounds(tester).top, closeTo(original.top, 0.1));
+    await finish(tester);
+  });
+
+  testWidgets('long press opens the image menu without dismissing the gallery',
+      (tester) async {
+    await open(tester);
+    final finger = await tester.startGesture(const Offset(195, 400));
+    await tester.pump(const Duration(milliseconds: 650));
+    expect(find.byType(AlertDialog), findsOneWidget);
+    expect(find.text('保存图片'), findsOneWidget);
+    await finger.moveBy(const Offset(0, 200),
+        timeStamp: const Duration(milliseconds: 700));
+    await finger.up(timeStamp: const Duration(milliseconds: 750));
+    await tester.pumpAndSettle();
+    expect(find.byType(AlertDialog), findsOneWidget);
+    // Dismiss only the menu. No save/share action or platform plugin is invoked.
+    Get.back();
+    await tester.pumpAndSettle();
+    expect(find.byType(ImageViewPage), findsOneWidget);
+    expect(pages(tester).page, closeTo(0, 0.01));
+    await finish(tester);
+  });
+}
diff --git a/apps/flutter/test/lite/ios_image_transition_test.dart b/apps/flutter/test/lite/ios_image_transition_test.dart
new file mode 100644
index 0000000..7f7af69
--- /dev/null
+++ b/apps/flutter/test/lite/ios_image_transition_test.dart
@@ -0,0 +1,136 @@
+import 'package:c001apk_flutter/router/app_pages.dart';
+import 'package:c001apk_flutter/router/page_transitions.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:get/get.dart';
+
+void main() {
+  const sourceKey = ValueKey('gallery-source-page');
+  const galleryKey = ValueKey('gallery-transition-page');
+  const viewport = Rect.fromLTWH(0, 0, 390, 844);
+
+  tearDown(Get.reset);
+
+  Rect paintedBounds(WidgetTester tester, Key key) {
+    final finder = find.byKey(key, skipOffstage: false);
+    final box = tester.renderObject<RenderBox>(finder);
+    return Rect.fromPoints(box.localToGlobal(Offset.zero),
+        box.localToGlobal(box.size.bottomRight(Offset.zero)));
+  }
+
+  Future<void> mount(WidgetTester tester, {bool fromFeed = false}) async {
+    await tester.binding.setSurfaceSize(viewport.size);
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    Widget source() => Scaffold(
+          key: sourceKey,
+          body: Center(
+            child: TextButton(
+              onPressed: () => Get.toNamed('/imageview'),
+              child: const Text('打开缩略图'),
+            ),
+          ),
+        );
+    final gallery =
+        AppPages.getPages.firstWhere((page) => page.name == '/imageview');
+    final feed =
+        AppPages.getPages.firstWhere((page) => page.name == '/feed/:id');
+    await tester.pumpWidget(GetMaterialApp(
+      popGesture: false,
+      customTransition: AppPageTransition(),
+      theme: ThemeData(platform: TargetPlatform.iOS),
+      initialRoute: '/',
+      getPages: [
+        GetPage(name: '/', page: () => fromFeed ? const Scaffold() : source()),
+        feed.copy(page: source),
+        gallery.copy(
+            page: () => const Scaffold(
+                key: galleryKey, body: Center(child: Text('图片详情')))),
+      ],
+    ));
+    await tester.pumpAndSettle();
+    if (fromFeed) {
+      Get.toNamed('/feed/123');
+      await tester.pumpAndSettle();
+    }
+  }
+
+  Future<void> finish(WidgetTester tester) async {
+    expect(tester.takeException(), isNull);
+    await tester.pumpWidget(const SizedBox.shrink());
+    await tester.pumpAndSettle();
+    expect(tester.takeException(), isNull);
+  }
+
+  for (final fromFeed in [false, true]) {
+    testWidgets(
+        'gallery expands in place from ${fromFeed ? 'a post' : 'the list'} without moving its source',
+        (tester) async {
+      await mount(tester, fromFeed: fromFeed);
+      final sourceBefore = paintedBounds(tester, sourceKey);
+      await tester.tap(find.text('打开缩略图'));
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 60));
+      final early = paintedBounds(tester, galleryKey);
+      expect(early.width, lessThan(viewport.width - 5));
+      expect(early.center.dx, closeTo(viewport.center.dx, 0.01));
+      expect(early.center.dy, closeTo(viewport.center.dy, 0.01));
+      expect(early.width / viewport.width,
+          closeTo(early.height / viewport.height, 0.001));
+      expect(paintedBounds(tester, sourceKey), sourceBefore);
+
+      await tester.pump(const Duration(milliseconds: 120));
+      final later = paintedBounds(tester, galleryKey);
+      expect(later.width, greaterThan(early.width));
+      expect(later.center.dx, closeTo(viewport.center.dx, 0.01));
+      expect(paintedBounds(tester, sourceKey), sourceBefore);
+      await tester.pumpAndSettle();
+      expect(paintedBounds(tester, galleryKey), viewport);
+
+      Get.back();
+      await tester.pump();
+      await tester.pump(const Duration(milliseconds: 120));
+      final closing = paintedBounds(tester, galleryKey);
+      expect(closing.width, lessThan(viewport.width));
+      expect(closing.center.dx, closeTo(viewport.center.dx, 0.01));
+      expect(paintedBounds(tester, sourceKey), sourceBefore);
+      await tester.pumpAndSettle();
+      expect(find.text('图片详情'), findsNothing);
+      await finish(tester);
+    });
+  }
+
+  testWidgets('gallery zoom respects reduced motion', (tester) async {
+    tester.platformDispatcher.accessibilityFeaturesTestValue =
+        const FakeAccessibilityFeatures(disableAnimations: true);
+    addTearDown(tester.platformDispatcher.clearAccessibilityFeaturesTestValue);
+    await mount(tester);
+    await tester.tap(find.text('打开缩略图'));
+    await tester.pump();
+    await tester.pump(const Duration(milliseconds: 60));
+    expect(paintedBounds(tester, galleryKey), viewport);
+    expect(paintedBounds(tester, sourceKey), viewport);
+    await tester.pumpAndSettle();
+    await finish(tester);
+  });
+
+  testWidgets('gallery edge cancellation stays horizontal and restores scale',
+      (tester) async {
+    await mount(tester);
+    await tester.tap(find.text('打开缩略图'));
+    await tester.pumpAndSettle();
+    final pointer = await tester.startGesture(const Offset(5, 400));
+    await pointer.moveBy(const Offset(35, 0));
+    await tester.pump();
+    await pointer.moveBy(const Offset(100, 0));
+    await tester.pump();
+    final dragging = paintedBounds(tester, galleryKey);
+    expect(dragging.left, closeTo(100, 2));
+    expect(dragging.size, viewport.size);
+    expect(paintedBounds(tester, sourceKey), viewport);
+    await pointer.cancel();
+    await tester.pumpAndSettle();
+    expect(paintedBounds(tester, galleryKey), viewport);
+    expect(Get.key.currentState!.userGestureInProgress, isFalse);
+    await finish(tester);
+  });
+}
